(praxis_security_headers) {
	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

praxis.example {
	root * /srv/praxis/current
	encode zstd gzip

	import praxis_security_headers

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	route {
		@reservedKnowledgeItem {
			path /knowledge
			vars_regexp reservedKnowledgeItemQuery {query} (?:^|&)item=(?:agent-app-development|llm-principles|fine-tuning-inference-deployment|practice-cases|knowledge-frontier)(?:&|$)
		}
		rewrite @reservedKnowledgeItem /_knowledge-query-not-found

		@knowledgeItem {
			path /knowledge
			vars_regexp knowledgeItemQuery {query} ^(?:item=[a-z0-9][a-z0-9-]{0,119}(?:&section=(?:agents|llm|model-engineering|practice|frontier))?|section=(?:agents|llm|model-engineering|practice|frontier)&item=[a-z0-9][a-z0-9-]{0,119})$
		}
		rewrite @knowledgeItem /knowledge/{query.item}

		@knowledgeAgents {
			path /knowledge
			vars {query} section=agents
		}
		rewrite @knowledgeAgents /knowledge/agent-app-development

		@knowledgeLlm {
			path /knowledge
			vars {query} section=llm
		}
		rewrite @knowledgeLlm /knowledge/llm-principles

		@knowledgeModelEngineering {
			path /knowledge
			vars {query} section=model-engineering
		}
		rewrite @knowledgeModelEngineering /knowledge/fine-tuning-inference-deployment

		@knowledgePractice {
			path /knowledge
			vars {query} section=practice
		}
		rewrite @knowledgePractice /knowledge/practice-cases

		@knowledgeFrontier {
			path /knowledge
			vars {query} section=frontier
		}
		rewrite @knowledgeFrontier /knowledge/knowledge-frontier

		@unknownKnowledgeQuery {
			path /knowledge
			expression {query} != ''
		}
		rewrite @unknownKnowledgeQuery /_knowledge-query-not-found

		@rootIndexWithQuery {
			path /index.html
			expression {query} != ''
		}
		redir @rootIndexWithQuery /?{query} permanent

		@rootIndex path /index.html
		redir @rootIndex / permanent

		@indexDocumentWithQuery {
			path_regexp indexDocumentWithQuery ^(.+)/index\.html$
			expression {query} != ''
		}
		redir @indexDocumentWithQuery {re.indexDocumentWithQuery.1}?{query} permanent

		@indexDocument path_regexp indexDocument ^(.+)/index\.html$
		redir @indexDocument {re.indexDocument.1} permanent

		@trailingSlashWithQuery {
			path_regexp trailingSlashWithQuery ^(.+)/$
			expression {query} != ''
		}
		redir @trailingSlashWithQuery {re.trailingSlashWithQuery.1}?{query} permanent

		@trailingSlash path_regexp trailingSlash ^(.+)/$
		redir @trailingSlash {re.trailingSlash.1} permanent

		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		@notFound expression {http.error.status_code} == 404
		rewrite @notFound /404.html
		import praxis_security_headers
		file_server
	}

	# Future API seam — enable only when apps/api exists.
	# handle_path /api/* {
	# 	reverse_proxy praxis-api:8000
	# }
}
