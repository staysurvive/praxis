(praxis_security_headers) {
	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

praxis.example {
	root * /srv/praxis
	encode zstd gzip

	import praxis_security_headers

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@rootIndexWithQuery {
		path /index.html
		expression {query} != ''
	}
	redir @rootIndexWithQuery /?{query} permanent

	@rootIndex path /index.html
	redir @rootIndex / permanent

	@indexDocumentWithQuery {
		path_regexp indexDocumentWithQuery ^(.+)/index\.html$
		expression {query} != ''
	}
	redir @indexDocumentWithQuery {re.indexDocumentWithQuery.1}?{query} permanent

	@indexDocument path_regexp indexDocument ^(.+)/index\.html$
	redir @indexDocument {re.indexDocument.1} permanent

	@trailingSlashWithQuery {
		path_regexp trailingSlashWithQuery ^(.+)/$
		expression {query} != ''
	}
	redir @trailingSlashWithQuery {re.trailingSlashWithQuery.1}?{query} permanent

	@trailingSlash path_regexp trailingSlash ^(.+)/$
	redir @trailingSlash {re.trailingSlash.1} permanent

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@notFound expression {http.error.status_code} == 404
		rewrite @notFound /404.html
		import praxis_security_headers
		file_server
	}

	# Future API seam — enable only when apps/api exists.
	# handle_path /api/* {
	# 	reverse_proxy praxis-api:8000
	# }
}
