FROM node:22-alpine AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/web apps/web
COPY content content

ARG SITE_URL=https://praxis.example
ENV SITE_URL=$SITE_URL

RUN npm run build

FROM busybox:1.37

COPY --from=build /workspace/apps/web/dist /site

CMD ["sh", "-c", "rm -rf /output/* && cp -R /site/. /output/"]
