FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/web apps/web
COPY content content

ARG SITE_URL
ENV SITE_URL=$SITE_URL
ENV ASTRO_TELEMETRY_DISABLED=1

RUN npm run build:production

FROM busybox:1.37@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0

COPY --from=build /workspace/apps/web/dist /site
COPY infra/export-web-dist.sh /export-web-dist.sh

CMD ["sh", "/export-web-dist.sh"]
