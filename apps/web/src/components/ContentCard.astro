---
import { uiCopy } from '../config/copy';
import type { ContentSummary } from '../lib/content';
import ContentMeta from './ContentMeta.astro';

interface Props {
  entry: ContentSummary;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
---

<article class:list={['content-card', featured && 'content-card--featured']}>
  <ContentMeta entry={entry} showStatus={featured} />
  <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div>
      <h3 class="content-title">
        <a href={entry.url}>{entry.title}</a>
      </h3>
      <p class="content-summary">{entry.summary}</p>
    </div>
    <a class="text-link whitespace-nowrap" href={entry.url}>{uiCopy.actions.readMore}</a>
  </div>
</article>

<style>
  .content-card {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
  }

  .content-card--featured {
    padding: 2rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .content-title {
    max-width: 28ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-title-2);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.4;
    text-wrap: balance;
  }

  .content-title a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .content-title a:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .content-summary {
    max-width: 46rem;
    margin: 0.9rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.9;
  }
</style>
