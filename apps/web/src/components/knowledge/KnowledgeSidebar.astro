---
import {
  BookOpenText,
  BrainCircuit,
  ChevronDown,
  ChevronRight,
  FileText,
  FlaskConical,
  Rocket,
  Search,
  ServerCog,
  Telescope,
} from 'lucide-astro';

import { uiCopy } from '../../config/copy';
import { getKnowledgeContextUrl, getKnowledgeUrl } from '../../lib/content/domain';
import type { KnowledgeSidebarEntry, KnowledgeSidebarSection } from './types';

interface Props {
  sections: readonly KnowledgeSidebarSection[];
  recentEntries: readonly KnowledgeSidebarEntry[];
  overviewIsCurrent?: boolean;
}

const { sections, recentEntries, overviewIsCurrent = false } = Astro.props satisfies Props;
const itemCount = sections.length + recentEntries.length;
const currentSection = sections.find((section) => section.isCurrent);
const overviewHref = getKnowledgeContextUrl(getKnowledgeUrl(), currentSection?.key);
const sectionIcons = {
  'agent-app-development': Rocket,
  'llm-principles': BrainCircuit,
  'fine-tuning-inference-deployment': ServerCog,
  'practice-cases': FlaskConical,
  'knowledge-frontier': Telescope,
};
const sectionLinks = sections.map((section) => ({
  section,
  Icon: sectionIcons[section.key],
}));
---

<aside class="knowledge-sidebar" data-knowledge-sidebar>
  <details class="knowledge-sidebar__disclosure" open>
    <summary class="knowledge-sidebar__summary">
      <BookOpenText
        class="knowledge-sidebar__icon knowledge-sidebar__summary-icon"
        size={18}
        strokeWidth={1.8}
        aria-hidden="true"
      />
      <span>{uiCopy.knowledge.chaptersLabel}</span>
      <ChevronDown
        class="knowledge-sidebar__icon knowledge-sidebar__summary-chevron"
        size={16}
        strokeWidth={1.8}
        aria-hidden="true"
      />
    </summary>

    <div class="knowledge-sidebar__body">
      <div class="knowledge-filter" data-knowledge-filter>
        <label class="sr-only" for="knowledge-filter-input">
          {uiCopy.accessibility.knowledgeFilter}
        </label>
        <div class="knowledge-filter__control">
          <Search
            class="knowledge-sidebar__icon knowledge-filter__icon"
            size={16}
            strokeWidth={1.8}
            aria-hidden="true"
          />
          <input
            id="knowledge-filter-input"
            type="search"
            placeholder={uiCopy.knowledge.filterPlaceholder}
            autocomplete="off"
            data-knowledge-filter-input
          />
          <kbd>{uiCopy.knowledge.filterShortcut}</kbd>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-knowledge-filter-status>
          {uiCopy.knowledge.filterResultPrefix}
          {itemCount}
          {uiCopy.knowledge.filterResultSuffix}
        </p>
      </div>

      <nav aria-label={uiCopy.accessibility.knowledgeDocsNavigation}>
        <a
          class="knowledge-sidebar__nav-link knowledge-sidebar__nav-link--overview"
          href={overviewHref}
          aria-current={overviewIsCurrent ? 'page' : undefined}
          data-knowledge-overview-link
          data-astro-prefetch="hover"
        >
          <BookOpenText
            class="knowledge-sidebar__icon knowledge-sidebar__nav-icon"
            size={16}
            strokeWidth={1.8}
            aria-hidden="true"
          />
          <span class="knowledge-sidebar__item-copy">
            <strong>{uiCopy.knowledge.overviewLabel}</strong>
          </span>
          <ChevronRight
            class="knowledge-sidebar__icon knowledge-sidebar__chevron"
            size={16}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </a>

        <section
          class="knowledge-sidebar__group knowledge-sidebar__group--chapters"
          aria-labelledby="knowledge-chapters-title"
        >
          <h2 id="knowledge-chapters-title" class="sr-only">
            {uiCopy.knowledge.chaptersLabel}
          </h2>
          <ol>
            {
              sectionLinks.map(({ section, Icon }) => (
                <li
                  data-knowledge-filter-item
                  data-knowledge-filter-key={`section:${section.key}`}
                  data-knowledge-filter-text={`${section.label} ${section.description} ${section.topics.join(' ')}`}
                >
                  <a
                    class="knowledge-sidebar__nav-link"
                    href={section.href}
                    title={section.label}
                    aria-current={section.isCurrent ? 'page' : undefined}
                    data-knowledge-section-link
                    data-knowledge-section-key={section.key}
                    data-knowledge-section-number={section.number}
                    data-astro-prefetch="hover"
                  >
                    <Icon
                      class="knowledge-sidebar__icon knowledge-sidebar__nav-icon knowledge-sidebar__nav-icon--section"
                      size={16}
                      strokeWidth={1.8}
                      aria-hidden="true"
                    />
                    <span class="knowledge-sidebar__item-copy">
                      <strong>{section.label}</strong>
                      <small class="knowledge-sidebar__description">{section.description}</small>
                    </span>
                    <span class="sr-only" data-knowledge-section-count>
                      {uiCopy.knowledge.sectionCount(section.count)}
                    </span>
                    <ChevronRight
                      class="knowledge-sidebar__icon knowledge-sidebar__chevron"
                      size={16}
                      strokeWidth={1.8}
                      aria-hidden="true"
                    />
                  </a>
                </li>
              ))
            }
          </ol>
        </section>

        <section
          class="knowledge-sidebar__group knowledge-sidebar__group--recent"
          aria-labelledby="knowledge-recent-title"
        >
          <h2 id="knowledge-recent-title">{uiCopy.knowledge.recentLabel}</h2>
          <ul>
            {
              recentEntries.map((entry) => (
                <li
                  data-knowledge-filter-item
                  data-knowledge-filter-key={`entry:${entry.key}`}
                  data-knowledge-filter-text={`${entry.title} ${entry.summary} ${entry.tags.join(' ')} ${entry.typeLabel}`}
                >
                  <a
                    class="knowledge-sidebar__nav-link knowledge-sidebar__nav-link--article"
                    href={entry.href}
                    title={entry.title}
                    aria-current={entry.isCurrent ? 'page' : undefined}
                    data-knowledge-recent-link
                    data-astro-prefetch="hover"
                  >
                    <FileText
                      class="knowledge-sidebar__icon knowledge-sidebar__nav-icon"
                      size={16}
                      strokeWidth={1.8}
                      aria-hidden="true"
                    />
                    <span class="knowledge-sidebar__item-copy">
                      <strong>{entry.title}</strong>
                      <small class="sr-only">{entry.typeLabel}</small>
                    </span>
                    <ChevronRight
                      class="knowledge-sidebar__icon knowledge-sidebar__chevron"
                      size={16}
                      strokeWidth={1.8}
                      aria-hidden="true"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </nav>
    </div>
  </details>
</aside>

<style>
  .knowledge-sidebar {
    --knowledge-nav-radius: 0.75rem;

    min-width: 0;
  }

  .knowledge-sidebar__disclosure,
  .knowledge-sidebar__body {
    min-width: 0;
  }

  .knowledge-sidebar__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--knowledge-nav-radius);
    background: var(--color-bg-surface);
    color: var(--color-fg);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.45;
    list-style: none;
  }

  .knowledge-sidebar__summary::marker,
  .knowledge-sidebar__summary::-webkit-details-marker {
    display: none;
    content: '';
  }

  .knowledge-sidebar__summary-chevron {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .knowledge-sidebar__disclosure[open] .knowledge-sidebar__summary-chevron {
    transform: rotate(180deg);
  }

  .knowledge-sidebar__body {
    padding-block: 1rem;
  }

  .knowledge-filter {
    display: none;
    margin-bottom: 1rem;
  }

  :global([data-knowledge-docs-ready]) .knowledge-filter {
    display: block;
  }

  .knowledge-filter__control {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--knowledge-nav-radius);
    background: color-mix(in srgb, var(--color-bg-surface) 72%, transparent);
    color: var(--color-fg-subtle);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .knowledge-filter__control:hover {
    background: var(--color-bg-surface);
  }

  .knowledge-filter__control:focus-within {
    border-color: var(--color-focus-ring);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-focus);
  }

  .knowledge-filter input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .knowledge-filter input::placeholder {
    color: var(--color-fg-subtle);
  }

  .knowledge-filter kbd {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.4rem;
    padding-inline: 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: 0.35rem;
    background: var(--color-bg);
    color: var(--color-fg-subtle);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1;
    white-space: nowrap;
  }

  .knowledge-sidebar__group {
    margin-top: 0;
  }

  .knowledge-sidebar__group--chapters {
    margin-top: 0.25rem;
  }

  .knowledge-sidebar__group--recent {
    margin-top: 1.5rem;
  }

  .knowledge-sidebar__group h2 {
    margin: 0 0 0.65rem;
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.5;
  }

  .knowledge-sidebar__group ol,
  .knowledge-sidebar__group ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knowledge-sidebar__group li[hidden] {
    display: none;
  }

  .knowledge-sidebar__nav-link {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) 1rem;
    gap: 0.75rem;
    align-items: start;
    min-width: 0;
    min-block-size: 2.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--knowledge-nav-radius);
    color: var(--color-fg-muted);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .knowledge-sidebar__nav-link:hover {
    background: var(--color-bg-surface);
    color: var(--color-fg);
  }

  .knowledge-sidebar__nav-link[aria-current='page'] {
    background: color-mix(in srgb, var(--color-brand-tint) 82%, transparent);
    color: var(--color-brand-strong);
    font-weight: 500;
  }

  .knowledge-sidebar__item-copy {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
  }

  .knowledge-sidebar__item-copy strong {
    min-width: 0;
    overflow-wrap: anywhere;
    color: inherit;
    font-size: 0.875rem;
    font-weight: inherit;
    letter-spacing: 0;
    line-height: 1.45;
  }

  .knowledge-sidebar__item-copy small {
    overflow-wrap: anywhere;
    color: var(--color-fg-subtle);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .knowledge-sidebar :global(.knowledge-sidebar__icon) {
    flex: 0 0 auto;
    color: var(--color-fg-subtle);
  }

  .knowledge-sidebar :global(.knowledge-sidebar__nav-icon) {
    margin-top: 0.12rem;
    color: color-mix(in srgb, var(--color-brand) 72%, var(--color-fg-subtle));
  }

  .knowledge-sidebar :global(.knowledge-sidebar__chevron) {
    margin-top: 0.12rem;
    color: var(--color-fg-subtle);
  }

  .knowledge-sidebar__nav-link:hover :global(.knowledge-sidebar__chevron) {
    color: var(--color-fg-muted);
  }

  .knowledge-sidebar__nav-link[aria-current='page']
    :global(:is(.knowledge-sidebar__nav-icon, .knowledge-sidebar__chevron)) {
    color: var(--color-brand);
  }

  @media (min-width: 64rem) {
    .knowledge-sidebar {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
      align-self: start;
    }

    .knowledge-sidebar__summary {
      display: none;
    }

    .knowledge-sidebar__disclosure:not([open]) > .knowledge-sidebar__body {
      display: block;
    }

    .knowledge-sidebar__body {
      padding-block: 0;
    }

    .knowledge-sidebar__nav-link {
      align-items: center;
      height: 2.5rem;
    }

    .knowledge-sidebar__item-copy {
      display: block;
    }

    .knowledge-sidebar__item-copy strong {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .knowledge-sidebar__description {
      display: none;
    }

    .knowledge-sidebar :global(.knowledge-sidebar__nav-icon),
    .knowledge-sidebar :global(.knowledge-sidebar__chevron) {
      margin-top: 0;
    }
  }

  @media (min-width: 64rem) and (max-height: 45rem) {
    .knowledge-sidebar {
      position: static;
    }
  }
</style>
