---
import {
  BrainCircuit,
  ChevronRight,
  FileText,
  FlaskConical,
  Rocket,
  Search,
  ServerCog,
  Telescope,
} from 'lucide-astro';

import { uiCopy } from '../../config/copy';
import { formatDateKey } from '../../lib/date';
import type { KnowledgeSidebarEntry, KnowledgeSidebarSection } from './types';

interface Props {
  sections: readonly KnowledgeSidebarSection[];
  recentEntries: readonly KnowledgeSidebarEntry[];
}

const { sections, recentEntries } = Astro.props satisfies Props;
const sectionIcons = {
  'agent-app-development': Rocket,
  'llm-principles': BrainCircuit,
  'fine-tuning-inference-deployment': ServerCog,
  'practice-cases': FlaskConical,
  'knowledge-frontier': Telescope,
};
const firstSection = sections[0];
const itemCount = sections.length + recentEntries.length;
---

<article class="knowledge-workspace" data-knowledge-workspace>
  <header id="workspace-start" class="knowledge-workspace__header">
    <p class="eyebrow">{uiCopy.knowledge.workspaceEyebrow}</p>
    <h1>{uiCopy.knowledge.workspaceTitle}</h1>
    <p class="knowledge-workspace__lede">{uiCopy.knowledge.workspaceDescription}</p>

    <div class="knowledge-workspace__tools">
      {
        firstSection && (
          <a
            class="knowledge-workspace__start"
            href={firstSection.href}
            data-astro-prefetch="hover"
          >
            <Rocket size={19} strokeWidth={1.8} aria-hidden="true" />
            <span>
              <small>{uiCopy.knowledge.startReadingTitle}</small>
              <strong>{firstSection.label}</strong>
              <span>{uiCopy.knowledge.startReadingDescription}</span>
            </span>
            <span class="knowledge-workspace__start-action">
              {uiCopy.knowledge.startReadingAction}
              <ChevronRight size={17} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </a>
        )
      }

      <div class="knowledge-workspace-filter" data-knowledge-workspace-filter>
        <label class="sr-only" for="knowledge-workspace-filter-input">
          {uiCopy.accessibility.knowledgeFilter}
        </label>
        <div class="knowledge-workspace-filter__control">
          <Search size={17} strokeWidth={1.8} aria-hidden="true" />
          <input
            id="knowledge-workspace-filter-input"
            type="search"
            placeholder={uiCopy.knowledge.filterPlaceholder}
            autocomplete="off"
            data-knowledge-filter-input
          />
          <kbd>{uiCopy.knowledge.filterShortcut}</kbd>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-knowledge-filter-status>
          {uiCopy.knowledge.filterResultPrefix}
          {itemCount}
          {uiCopy.knowledge.filterResultSuffix}
        </p>
      </div>
    </div>
  </header>

  <section id="workspace-chapters" class="knowledge-workspace__section">
    <div class="knowledge-workspace__section-heading">
      <div>
        <p class="eyebrow">{uiCopy.knowledge.chaptersLabel}</p>
        <h2>{uiCopy.knowledge.browseChaptersTitle}</h2>
      </div>
      <p>{uiCopy.knowledge.browseChaptersDescription}</p>
    </div>

    <ol class="knowledge-workspace__chapters">
      {
        sections.map((section) => {
          const Icon = sectionIcons[section.key];
          return (
            <li
              data-knowledge-filter-item
              data-knowledge-filter-key={`section:${section.key}`}
              data-knowledge-filter-text={`${section.label} ${section.description} ${section.topics.join(' ')}`}
            >
              <a href={section.href} data-astro-prefetch="hover">
                <span class="knowledge-workspace__chapter-icon">
                  <Icon size={18} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <span class="knowledge-workspace__chapter-copy">
                  <small>{`${uiCopy.knowledge.chapterEyebrow} ${section.number}`}</small>
                  <strong>{section.label}</strong>
                  <span>{section.description}</span>
                </span>
                <span class="knowledge-workspace__chapter-meta">
                  <span>{uiCopy.knowledge.sectionCount(section.count)}</span>
                  <ChevronRight size={17} strokeWidth={1.8} aria-hidden="true" />
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section id="workspace-recent" class="knowledge-workspace__section">
    <div class="knowledge-workspace__section-heading">
      <div>
        <p class="eyebrow">{uiCopy.knowledge.recentEyebrow}</p>
        <h2>{uiCopy.knowledge.recentTitle}</h2>
      </div>
      <p>{uiCopy.knowledge.recentDescription}</p>
    </div>

    <div class="knowledge-workspace__recent-list">
      {
        recentEntries.map((entry) => (
          <article
            data-knowledge-filter-item
            data-knowledge-filter-key={`entry:${entry.key}`}
            data-knowledge-filter-text={`${entry.title} ${entry.summary} ${entry.tags.join(' ')} ${entry.typeLabel}`}
          >
            <FileText size={17} strokeWidth={1.8} aria-hidden="true" />
            <div>
              <p>
                <span>{entry.typeLabel}</span>
                <time datetime={entry.updatedAt}>{formatDateKey(entry.updatedAt)}</time>
              </p>
              <h3>
                <a href={entry.href} data-astro-prefetch="hover">
                  {entry.title}
                </a>
              </h3>
              <p>{entry.summary}</p>
            </div>
            <ChevronRight size={17} strokeWidth={1.8} aria-hidden="true" />
          </article>
        ))
      }
    </div>
    <p class="knowledge-workspace__empty" hidden data-knowledge-filter-empty-message>
      {uiCopy.knowledge.filterEmptyResult}
    </p>
  </section>
</article>

<style>
  .knowledge-workspace {
    min-width: 0;
  }

  .knowledge-workspace__header {
    padding-block: 1.5rem clamp(2.75rem, 5vw, 4rem);
    border-bottom: 2px solid var(--color-line-strong);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .knowledge-workspace__header > .eyebrow {
    margin: 0 0 1.1rem;
    letter-spacing: 0;
  }

  .knowledge-workspace__header h1 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.13;
    text-wrap: balance;
  }

  .knowledge-workspace__lede {
    max-width: var(--measure-cjk);
    margin: 1rem 0 0;
    color: var(--color-fg-muted);
    font-size: 1.05rem;
    line-height: 1.95;
  }

  .knowledge-workspace__tools {
    display: grid;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .knowledge-workspace__start {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    min-width: 0;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-brand) 32%, var(--color-line));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-brand-tint) 82%, transparent);
    color: var(--color-fg);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .knowledge-workspace__start > :global(svg) {
    color: var(--color-brand);
  }

  .knowledge-workspace__start > span:nth-child(2) {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
  }

  .knowledge-workspace__start small {
    color: var(--color-brand-strong);
    font-size: var(--text-kicker);
    font-weight: 600;
    letter-spacing: 0;
  }

  .knowledge-workspace__start strong {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .knowledge-workspace__start > span > span {
    color: var(--color-fg-muted);
    font-size: var(--text-meta);
    line-height: 1.6;
  }

  .knowledge-workspace__start-action {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    color: var(--color-brand-strong);
    font-size: var(--text-meta);
    font-weight: 600;
    white-space: nowrap;
  }

  .knowledge-workspace-filter {
    display: none;
  }

  :global([data-knowledge-docs-ready]) .knowledge-workspace-filter {
    display: block;
  }

  .knowledge-workspace-filter__control {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg-surface);
    color: var(--color-fg-subtle);
  }

  .knowledge-workspace-filter__control:focus-within {
    border-color: var(--color-focus-ring);
    box-shadow: var(--shadow-focus);
  }

  .knowledge-workspace-filter input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-fg);
    font-size: 0.875rem;
  }

  .knowledge-workspace-filter input::placeholder {
    color: var(--color-fg-subtle);
  }

  .knowledge-workspace-filter kbd {
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: 0.35rem;
    background: var(--color-bg);
    color: var(--color-fg-subtle);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .knowledge-workspace__section {
    padding-block: clamp(2.75rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .knowledge-workspace__section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(15rem, 1fr);
    gap: 1rem 2rem;
    align-items: end;
  }

  .knowledge-workspace__section-heading .eyebrow,
  .knowledge-workspace__section-heading h2,
  .knowledge-workspace__section-heading > p {
    margin: 0;
  }

  .knowledge-workspace__section-heading h2 {
    margin-top: 0.45rem;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .knowledge-workspace__section-heading > p {
    color: var(--color-fg-muted);
    line-height: 1.8;
  }

  .knowledge-workspace__chapters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .knowledge-workspace__chapters li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .knowledge-workspace__chapters li[hidden],
  .knowledge-workspace__recent-list article[hidden] {
    display: none;
  }

  .knowledge-workspace__chapters a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    min-height: 100%;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-bg-surface) 72%, transparent);
    color: var(--color-fg);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .knowledge-workspace__chapter-icon {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.6rem;
    background: var(--color-brand-tint);
    color: var(--color-brand);
  }

  .knowledge-workspace__chapter-copy {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .knowledge-workspace__chapter-copy small {
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
    font-weight: 600;
    letter-spacing: 0;
  }

  .knowledge-workspace__chapter-copy strong {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .knowledge-workspace__chapter-copy > span {
    color: var(--color-fg-muted);
    font-size: var(--text-meta);
    line-height: 1.65;
  }

  .knowledge-workspace__chapter-meta {
    grid-column: 2;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.35rem;
    color: var(--color-fg-subtle);
    font-size: 0.72rem;
  }

  .knowledge-workspace__recent-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .knowledge-workspace__recent-list article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: start;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .knowledge-workspace__recent-list article > :global(svg) {
    margin-top: 0.2rem;
    color: color-mix(in srgb, var(--color-brand) 72%, var(--color-fg-subtle));
  }

  .knowledge-workspace__recent-list article > div {
    min-width: 0;
  }

  .knowledge-workspace__recent-list article > div > p:first-child {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin: 0;
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
    font-weight: 600;
  }

  .knowledge-workspace__recent-list h3 {
    margin: 0.4rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .knowledge-workspace__recent-list h3 a {
    color: var(--color-fg);
    text-decoration: none;
  }

  .knowledge-workspace__recent-list h3 + p {
    margin: 0.35rem 0 0;
    color: var(--color-fg-muted);
    font-size: var(--text-meta);
    line-height: 1.7;
  }

  .knowledge-workspace__recent-list article > :global(svg:last-child) {
    margin-top: 0.2rem;
    color: var(--color-fg-subtle);
  }

  .knowledge-workspace__empty {
    margin: 1.5rem 0 0;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    color: var(--color-fg-muted);
    text-align: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .knowledge-workspace__start:hover,
    .knowledge-workspace__chapters a:hover {
      border-color: color-mix(in srgb, var(--color-brand) 52%, var(--color-line));
      background: var(--color-brand-tint);
      transform: translateY(-1px);
    }

    .knowledge-workspace__recent-list h3 a:hover {
      color: var(--color-brand-strong);
    }
  }

  @media (max-width: 47.99rem) {
    .knowledge-workspace__start,
    .knowledge-workspace__section-heading,
    .knowledge-workspace__chapters {
      grid-template-columns: minmax(0, 1fr);
    }

    .knowledge-workspace__start > :global(svg) {
      display: none;
    }

    .knowledge-workspace__start-action {
      justify-content: space-between;
    }

    .knowledge-workspace__chapters li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (min-width: 64rem) {
    .knowledge-workspace__header {
      padding-block-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knowledge-workspace__start,
    .knowledge-workspace__chapters a {
      transition: none;
    }
  }
</style>
