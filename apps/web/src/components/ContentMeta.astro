---
import type { Status } from '../lib/content/domain';
import type { ContentSummary } from '../lib/content';
import { formatDateKey } from '../lib/date';

interface Props {
  entry: ContentSummary;
  showStatus?: boolean;
}

const { entry, showStatus = true } = Astro.props;

const statusGlyphs: Record<Status, string> = {
  draft: '○',
  ongoing: '●',
  completed: '■',
  reflected: '▲',
};
---

<div class="meta-line" aria-label={`${entry.typeLabel}内容信息`}>
  <span class="meta-type">{entry.typeLabel}</span>
  <span class="meta-sep" aria-hidden="true">·</span>
  <span class="meta-stage">{entry.stageLabel}</span>
  {
    showStatus && (
      <>
        <span class="meta-sep" aria-hidden="true">
          ·
        </span>
        <span class="meta-status">
          <span aria-hidden="true">{statusGlyphs[entry.status]}</span> {entry.statusLabel}
        </span>
      </>
    )
  }
  <span class="meta-sep" aria-hidden="true">·</span>
  <time class="meta-date" datetime={entry.publishedAt}>{formatDateKey(entry.publishedAt)}</time>
</div>

<style>
  .meta-type {
    color: var(--color-text);
  }

  .meta-stage {
    color: var(--color-accent);
  }

  .meta-status,
  .meta-date {
    color: var(--color-text-faint);
  }

  .meta-date {
    letter-spacing: 0.04em;
  }
</style>
