---
import { uiCopy } from '../config/copy';
import type { Status } from '../lib/content/domain';
import type { ContentSummary } from '../lib/content';
import { formatDateKey } from '../lib/date';

interface Props {
  entry: ContentSummary;
  showStatus?: boolean;
}

const { entry, showStatus = true } = Astro.props;
const typeLabel = uiCopy.contentTypes[entry.type];
const stageLabel = uiCopy.stages[entry.stage];
const statusLabel = uiCopy.statuses[entry.status];

const statusGlyphs: Record<Status, string> = {
  draft: '○',
  ongoing: '●',
  completed: '■',
  reflected: '▲',
};
---

<div class="meta-line" aria-label={`${typeLabel}内容信息`}>
  <span class="meta-type">{typeLabel}</span>
  <span class="meta-sep" aria-hidden="true">·</span>
  <span class="meta-stage">{stageLabel}</span>
  {
    showStatus && (
      <>
        <span class="meta-sep" aria-hidden="true">
          ·
        </span>
        <span class="meta-status">
          <span aria-hidden="true">{statusGlyphs[entry.status]}</span> {statusLabel}
        </span>
      </>
    )
  }
  <span class="meta-sep" aria-hidden="true">·</span>
  <time class="meta-date" datetime={entry.publishedAt}>{formatDateKey(entry.publishedAt)}</time>
</div>

<style>
  .meta-type {
    color: var(--color-fg);
  }

  .meta-stage {
    color: var(--color-fg-subtle);
  }

  .meta-status,
  .meta-date {
    color: var(--color-fg-subtle);
  }

  .meta-date {
    letter-spacing: 0.04em;
  }
</style>
