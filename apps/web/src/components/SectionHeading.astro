---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  titleId?: string;
}

const { eyebrow, title, description, titleId } = Astro.props;
---

<header
  class="section-heading grid gap-6 lg:grid-cols-[minmax(0,0.72fr)_minmax(18rem,0.48fr)] lg:items-end"
>
  <div>
    <p class="eyebrow eyebrow--folio mb-4">{eyebrow}</p>
    <h2 class="section-title" id={titleId}>{title}</h2>
  </div>
  {description && <p class="body-copy m-0 lg:justify-self-end">{description}</p>}
</header>
