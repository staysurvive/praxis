---
import { uiCopy } from '../config/copy';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-light-label={uiCopy.actions.switchToLight}
  data-dark-label={uiCopy.actions.switchToDark}
  aria-label={uiCopy.actions.switchTheme}
  title={uiCopy.actions.switchTheme}
>
  <span class="theme-toggle__icon-track" aria-hidden="true">
    <svg
      class="theme-toggle__icon theme-toggle__icon--sun"
      data-theme-icon="sun"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
    <svg
      class="theme-toggle__icon theme-toggle__icon--moon"
      data-theme-icon="moon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </span>
</button>

<script is:inline src="/scripts/theme-toggle.js"></script>

<style>
  .theme-toggle {
    --theme-toggle-icon-duration: 150ms;
    --theme-toggle-icon-distance: 0.625rem;
    --theme-toggle-surface: color-mix(in srgb, var(--color-bg-surface) 55%, var(--color-line));
    --theme-toggle-surface-hover: color-mix(
      in srgb,
      var(--color-bg-surface) 45%,
      var(--color-line)
    );

    display: none;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.75rem;
    background: var(--theme-toggle-surface);
    color: var(--color-fg);
    cursor: pointer;
    transition:
      background-color var(--theme-toggle-icon-duration) cubic-bezier(0.4, 0, 0.2, 1),
      color var(--theme-toggle-icon-duration) cubic-bezier(0.4, 0, 0.2, 1),
      transform var(--theme-toggle-icon-duration) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-toggle[data-theme-toggle-ready] {
    display: inline-flex;
  }

  .theme-toggle:hover {
    background: var(--theme-toggle-surface-hover);
    color: var(--color-fg);
    transform: scale(1.1);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle:focus-visible {
    border-radius: 0.75rem;
  }

  @media (hover: none), (pointer: coarse) {
    .theme-toggle:hover {
      background: var(--theme-toggle-surface);
      color: var(--color-fg);
      transform: none;
    }
  }

  .theme-toggle__icon-track {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    overflow: hidden;
    pointer-events: none;
  }

  .theme-toggle__icon {
    position: absolute;
    inset: 0;
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    opacity: 0;
    transform: translateY(calc(-1 * var(--theme-toggle-icon-distance)));
  }

  /* The visible glyph describes the next theme: Moon in light, Sun in dark. */
  .theme-toggle__icon--moon {
    opacity: 1;
    transform: translateY(0);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    opacity: 1;
    transform: translateY(0);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    opacity: 0;
    transform: translateY(calc(-1 * var(--theme-toggle-icon-distance)));
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__icon--sun {
      opacity: 1;
      transform: translateY(0);
    }

    :global(:root:not([data-theme='light'])) .theme-toggle__icon--moon {
      opacity: 0;
      transform: translateY(calc(-1 * var(--theme-toggle-icon-distance)));
    }
  }

  .theme-toggle[data-theme-transition='to-dark'] .theme-toggle__icon--moon,
  .theme-toggle[data-theme-transition='to-light'] .theme-toggle__icon--sun {
    animation: theme-toggle-icon-exit var(--theme-toggle-icon-duration) cubic-bezier(0.4, 0, 0.2, 1)
      both;
  }

  .theme-toggle[data-theme-transition='to-dark'] .theme-toggle__icon--sun,
  .theme-toggle[data-theme-transition='to-light'] .theme-toggle__icon--moon {
    animation: theme-toggle-icon-enter var(--theme-toggle-icon-duration)
      cubic-bezier(0.4, 0, 0.2, 1) var(--theme-toggle-icon-duration) both;
  }

  @keyframes theme-toggle-icon-exit {
    from {
      opacity: 1;
      transform: translateY(0);
    }

    to {
      opacity: 0;
      transform: translateY(var(--theme-toggle-icon-distance));
    }
  }

  @keyframes theme-toggle-icon-enter {
    from {
      opacity: 0;
      transform: translateY(calc(-1 * var(--theme-toggle-icon-distance)));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
