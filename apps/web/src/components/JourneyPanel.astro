---
import { uiCopy } from '../config/copy';
import { journeyKeys } from '../lib/content/domain';
import type { Journey } from '../lib/content/schema';

interface Props {
  journey?: Journey;
}

const { journey } = Astro.props;
const sections = journey
  ? journeyKeys.flatMap((key) => {
      const value = journey[key];
      return value ? [{ key, label: uiCopy.journey[key], value }] : [];
    })
  : [];
---

{
  sections.length > 0 && (
    <section class="journey-panel" aria-labelledby="journey-title">
      <div class="journey-intro">
        <p class="eyebrow">{uiCopy.journeyPanel.eyebrow}</p>
        <h2 id="journey-title">{uiCopy.journeyPanel.title}</h2>
        <p>{uiCopy.journeyPanel.description}</p>
      </div>
      <div class="journey-list">
        {sections.map((section, index) => (
          <article class="journey-item">
            <span class="journey-index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{section.label}</h3>
              <p>{section.value}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .journey-panel {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .journey-intro {
    max-width: 34rem;
  }

  .journey-intro h2,
  .journey-intro p {
    margin: 0;
  }

  .journey-intro h2 {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
  }

  .journey-intro > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-muted);
  }

  .journey-list {
    border-top: 1px solid var(--color-border);
  }

  .journey-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.7rem;
    border-bottom: 1px solid var(--color-border);
  }

  .journey-index {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .journey-item h3,
  .journey-item p {
    margin: 0;
  }

  .journey-item h3 {
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .journey-item p {
    max-width: 48rem;
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    line-height: 1.9;
  }

  @media (min-width: 56rem) {
    .journey-panel {
      grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    }
  }
</style>
