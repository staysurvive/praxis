---
import { uiCopy } from '../config/copy';

interface Props {
  title?: string;
  description?: string;
}

const { title = uiCopy.empty.title, description = uiCopy.empty.description } = Astro.props;
---

<div class="empty-state">
  <span class="empty-mark" aria-hidden="true"></span>
  <h2>{title}</h2>
  <p>{description}</p>
</div>

<style>
  .empty-state {
    padding-block: 0 var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .empty-mark {
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--color-brand);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
  }

  p {
    max-width: 40rem;
    margin-top: 0.75rem;
    color: var(--color-fg-muted);
    line-height: 1.9;
  }
</style>
