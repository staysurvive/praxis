---
import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import { getKnowledgeUrl, knowledgeSections } from '../lib/content/domain';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function getCurrentState(href: string): 'page' | 'location' | undefined {
  if (currentPath === href) {
    return 'page';
  }

  return currentPath.startsWith(`${href}/`) ? 'location' : undefined;
}
---

<header class="site-header">
  <div class="page-shell flex min-h-[var(--header-height)] items-center justify-between gap-5">
    <a class="brand" href="/" aria-label={`${siteConfig.name} · ${uiCopy.navigation.home}`}>
      <img
        class="brand-mark"
        src="/brand/favicon-mini-32x32.png"
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-name">{siteConfig.name}</span>
      <span class="brand-motto">{siteConfig.theme}</span>
    </a>

    <div class="header-actions flex items-center justify-end gap-3 sm:gap-5">
      <nav aria-label={uiCopy.accessibility.primaryNavigation}>
        <ul class="nav-list flex flex-wrap items-center justify-end gap-x-4 gap-y-1 sm:gap-x-5">
          {
            siteConfig.navigation.map((item) => {
              const currentState = getCurrentState(item.href);

              if (item.key === 'knowledge') {
                const isKnowledgeOverview = currentPath === item.href;

                return (
                  <li class="nav-item nav-item--knowledge">
                    <details class="knowledge-menu" data-knowledge-menu>
                      <summary
                        class:list={[
                          'nav-link',
                          'knowledge-menu-trigger',
                          currentState && 'nav-link--active',
                        ]}
                        aria-current={currentState}
                        data-knowledge-menu-trigger
                      >
                        <span class="knowledge-menu-trigger-content">
                          <span class="knowledge-menu-trigger-label">{item.label}</span>
                          <svg
                            class="knowledge-menu-trigger-icon"
                            viewBox="0 0 10 6"
                            aria-hidden="true"
                            data-knowledge-menu-trigger-icon
                          >
                            <path d="M1 1.25 5 4.75 9 1.25" />
                          </svg>
                        </span>
                      </summary>

                      <div class="knowledge-menu-flyout">
                        <div class="knowledge-menu-panel" data-knowledge-menu-panel>
                          <a
                            class="knowledge-menu-link knowledge-menu-link--overview"
                            href={item.href}
                            aria-current={isKnowledgeOverview ? 'page' : undefined}
                            data-knowledge-menu-link
                          >
                            <span class="knowledge-menu-label">
                              {uiCopy.navigation.knowledgeOverview}
                            </span>
                            <span class="knowledge-menu-description">
                              {uiCopy.navigation.knowledgeOverviewDescription}
                            </span>
                          </a>

                          <ul
                            class="knowledge-menu-list"
                            aria-label={uiCopy.accessibility.knowledgeNavigation}
                          >
                            {knowledgeSections.map((section) => {
                              const href = getKnowledgeUrl(section.slug);
                              return (
                                <li>
                                  <a
                                    class="knowledge-menu-link"
                                    href={href}
                                    aria-current={currentPath === href ? 'page' : undefined}
                                    data-knowledge-menu-link
                                  >
                                    <span class="knowledge-menu-label">{section.label}</span>
                                    <span class="knowledge-menu-description">
                                      {section.description}
                                    </span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </div>
                    </details>
                  </li>
                );
              }

              return (
                <li class="nav-item">
                  <a
                    class:list={['nav-link', currentState && 'nav-link--active']}
                    href={item.href}
                    aria-current={currentState}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div aria-label={uiCopy.accessibility.themeControl}>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script is:inline src="/scripts/knowledge-menu.js" defer></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-overlay-header);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .brand-mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .brand-name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .brand-motto {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-line);
    color: var(--color-fg-muted);
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    position: relative;
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Invisible hit-area extension: comfortable tap targets without moving a pixel. */
  .nav-link::before {
    position: absolute;
    inset: -0.8rem -0.45rem;
    content: '';
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    background: var(--color-brand);
    content: '';
    opacity: 0;
    transform: scaleX(0.3);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .nav-link--active {
    color: var(--color-fg);
  }

  .knowledge-menu {
    position: relative;
    --knowledge-menu-radius: 0.75rem;
    --knowledge-menu-border: var(--color-line-emphasis);
    --knowledge-menu-divider: color-mix(in srgb, var(--color-line) 56%, transparent);
    --knowledge-menu-surface: color-mix(
      in srgb,
      var(--color-bg-raised) 88%,
      var(--color-brand-tint)
    );
    --knowledge-menu-hover: color-mix(in srgb, var(--color-bg-raised) 40%, var(--color-brand-tint));
    --knowledge-menu-hover-edge: color-mix(in srgb, var(--color-brand) 72%, transparent);
    --knowledge-menu-shadow: var(--shadow-raised);
  }

  .knowledge-menu-trigger {
    display: inline-flex;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  .knowledge-menu-trigger::-webkit-details-marker {
    display: none;
  }

  .knowledge-menu-trigger::marker {
    content: '';
  }

  .knowledge-menu-trigger-content {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .knowledge-menu-trigger-label {
    unicode-bidi: isolate;
  }

  .knowledge-menu-trigger-icon {
    display: block;
    width: 0.625rem;
    height: 0.375rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transform: translateY(0.075em);
  }

  /* Keep the compact nav treatment; keyboard focus is the stronger underline below. */
  .knowledge-menu-trigger:focus-visible {
    box-shadow: none;
    outline: 0;
  }

  .knowledge-menu-trigger:focus-visible::after {
    background: var(--color-focus-ring);
    height: 2px;
  }

  .knowledge-menu[open] > .knowledge-menu-trigger {
    color: var(--color-fg);
  }

  .knowledge-menu-flyout {
    position: absolute;
    z-index: 30;
    inset-block-start: 100%;
    inset-inline-end: 0;
    width: min(20rem, calc(100vw - 3rem));
    padding-block-start: 0.55rem;
  }

  .knowledge-menu-panel {
    max-height: calc(100svh - var(--header-height) - 2rem);
    overflow: hidden auto;
    overscroll-behavior: contain;
    border: 1px solid var(--knowledge-menu-border);
    border-radius: var(--knowledge-menu-radius);
    background: var(--knowledge-menu-surface);
    box-shadow: var(--knowledge-menu-shadow);
  }

  .knowledge-menu-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knowledge-menu-link {
    display: grid;
    gap: 0.22rem;
    padding: 0.7rem 0.85rem;
    border-top: 1px solid var(--knowledge-menu-divider);
    color: var(--color-fg);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .knowledge-menu-link--overview {
    border-top: 0;
  }

  .knowledge-menu-link[aria-current='page'] {
    color: var(--color-fg);
  }

  .knowledge-menu-link:focus-visible {
    z-index: 1;
    background: var(--knowledge-menu-hover);
    box-shadow: inset 2px 0 0 var(--knowledge-menu-hover-edge);
    outline-offset: -3px;
  }

  .knowledge-menu-label {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .knowledge-menu-description {
    color: var(--color-fg-muted);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    line-height: 1.45;
  }

  .nav-link:focus-visible::after,
  .nav-link--active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      opacity: 0.72;
    }

    .nav-link:hover {
      color: var(--color-fg);
    }

    .nav-link:hover::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .knowledge-menu-link:hover {
      background: var(--knowledge-menu-hover);
      box-shadow: inset 2px 0 0 var(--knowledge-menu-hover-edge);
      color: var(--color-fg);
    }

    .knowledge-menu-link:hover .knowledge-menu-label {
      font-weight: 600;
    }
  }

  .knowledge-menu-link:focus-visible .knowledge-menu-label {
    font-weight: 600;
  }

  @media (max-width: 43rem) {
    .brand-motto {
      display: none;
    }

    .site-header :global(.page-shell) {
      position: relative;
      align-items: flex-start;
      padding-block: 1rem;
    }

    .knowledge-menu {
      position: static;
    }

    .nav-item--knowledge {
      position: static;
    }

    .knowledge-menu-flyout {
      inset-inline: 0;
      width: auto;
    }

    .knowledge-menu-panel {
      max-height: calc(100svh - 8.5rem);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-bg-surface);
      backdrop-filter: none;
    }
  }

  @media (max-width: 23rem) {
    .site-header :global(.page-shell) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem 1rem;
      align-items: center;
    }

    .header-actions {
      display: contents;
    }

    .header-actions nav {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .header-actions nav ul {
      justify-content: flex-start;
    }

    .header-actions > div {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
