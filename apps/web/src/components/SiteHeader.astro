---
import { Sparkle } from 'lucide-astro';

import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import { getKnowledgeUrl, knowledgeSections } from '../lib/content/domain';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function getCurrentState(href: string): 'page' | 'location' | undefined {
  if (currentPath === href) {
    return 'page';
  }

  return currentPath.startsWith(`${href}/`) ? 'location' : undefined;
}
---

<header class="site-header">
  <div class="page-shell flex min-h-[var(--header-height)] items-center justify-between gap-5">
    <a class="brand" href="/" aria-label={`${siteConfig.name} · ${uiCopy.navigation.home}`}>
      <img
        class="brand-mark"
        src="/brand/favicon-mini-32x32.png"
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-name">{siteConfig.name}</span>
      <span class="brand-motto" aria-hidden="true">
        <span class="brand-motto-orbit">
          <svg viewBox="0 0 108 36" preserveAspectRatio="none" focusable="false" aria-hidden="true">
            <path
              class="brand-motto-orbit-path"
              pathLength="1"
              d="M 7 28 C 31 34 73 32 98 18 C 105 14 106 9 99 6"></path>
          </svg>
        </span>
        <span class="brand-motto-glint">
          <Sparkle size={8} strokeWidth={1.25} />
        </span>
        <span class="brand-motto-text">{siteConfig.theme}</span>
      </span>
    </a>

    <div class="header-actions flex items-center justify-end gap-3 sm:gap-5">
      <nav aria-label={uiCopy.accessibility.primaryNavigation}>
        <ul class="nav-list flex flex-wrap items-center justify-end gap-x-4 gap-y-1 sm:gap-x-5">
          {
            siteConfig.navigation.map((item) => {
              const currentState = getCurrentState(item.href);

              if (item.key === 'knowledge') {
                return (
                  <li class="nav-item nav-item--knowledge" data-knowledge-menu-container>
                    <a
                      class:list={[
                        'nav-link',
                        'knowledge-menu-overview-link',
                        currentState && 'nav-link--active',
                      ]}
                      href={item.href}
                      aria-current={currentState}
                      data-knowledge-overview-link
                    >
                      {item.label}
                    </a>
                    <details class="knowledge-menu" data-knowledge-menu>
                      <summary
                        class="knowledge-menu-trigger"
                        aria-label={uiCopy.accessibility.knowledgeMenuTrigger}
                        data-knowledge-menu-trigger
                      >
                        <svg
                          class="knowledge-menu-trigger-icon"
                          viewBox="0 0 10 6"
                          aria-hidden="true"
                          data-knowledge-menu-trigger-icon
                        >
                          <path d="M1 1.25 5 4.75 9 1.25" />
                        </svg>
                      </summary>

                      <div class="knowledge-menu-flyout">
                        <div class="knowledge-menu-panel" data-knowledge-menu-panel>
                          <ul
                            class="knowledge-menu-list"
                            aria-label={uiCopy.accessibility.knowledgeNavigation}
                          >
                            {knowledgeSections.map((section) => {
                              const href = getKnowledgeUrl(section.slug);
                              return (
                                <li>
                                  <a
                                    class="knowledge-menu-link"
                                    href={href}
                                    aria-current={currentPath === href ? 'page' : undefined}
                                    data-knowledge-menu-link
                                  >
                                    <span class="knowledge-menu-label">{section.label}</span>
                                    <span class="knowledge-menu-description">
                                      {section.description}
                                    </span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </div>
                    </details>
                  </li>
                );
              }

              return (
                <li class="nav-item">
                  <a
                    class:list={['nav-link', currentState && 'nav-link--active']}
                    href={item.href}
                    aria-current={currentState}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div aria-label={uiCopy.accessibility.themeControl}>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script is:inline src="/scripts/knowledge-menu.js" defer></script>

<style>
  @font-face {
    font-family: 'Praxis Brand Serif';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url('/fonts/praxis-brand-serif.woff2') format('woff2');
    unicode-range: U+4E00, U+5408, U+77E5, U+884C;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-overlay-header);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .brand-name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .brand-motto {
    position: relative;
    display: flex;
    width: 6.75rem;
    height: 2.25rem;
    align-items: center;
    justify-content: flex-start;
    margin-left: -0.25rem;
    padding-left: 0.75rem;
    isolation: isolate;
  }

  .brand-motto::before {
    position: absolute;
    z-index: 2;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 1px;
    height: 1.375rem;
    background: color-mix(in srgb, var(--color-line-strong) 18%, transparent);
    content: '';
    transform: translateY(-50%);
  }

  .brand-motto::after {
    position: absolute;
    z-index: 0;
    inset: -0.2rem -0.3rem;
    pointer-events: none;
    content: '';
    opacity: 0.055;
    background-image:
      radial-gradient(
        ellipse at center,
        color-mix(in srgb, var(--color-brand-secondary) 92%, transparent) 0 8%,
        color-mix(in srgb, var(--color-brand-secondary) 38%, transparent) 34%,
        transparent 72%
      ),
      radial-gradient(
        circle at 18% 58%,
        color-mix(in srgb, var(--color-brand-secondary) 72%, transparent) 0 0.035rem,
        transparent 0.06rem
      ),
      radial-gradient(
        circle at 72% 34%,
        color-mix(in srgb, var(--color-brand-secondary) 56%, transparent) 0 0.025rem,
        transparent 0.05rem
      ),
      radial-gradient(
        circle at 46% 78%,
        color-mix(in srgb, var(--color-brand-secondary) 44%, transparent) 0 0.02rem,
        transparent 0.045rem
      );
    background-position:
      0% 78%,
      0 0,
      0.2rem 0.1rem,
      -0.1rem 0.18rem;
    background-repeat: no-repeat, repeat, repeat, repeat;
    background-size:
      2.7rem 1.4rem,
      1.15rem 0.9rem,
      1.7rem 1.1rem,
      2.05rem 1.35rem;
    transform: translate3d(0, 0, 0);
  }

  .brand-motto-orbit {
    position: absolute;
    z-index: 1;
    inset-block: 0.25rem;
    inset-inline: 0.35rem 0.3rem;
    opacity: 0.42;
    filter: drop-shadow(
      0 0 0.18rem color-mix(in srgb, var(--color-brand-secondary) 24%, transparent)
    );
    transform-origin: left center;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform 1.2s cubic-bezier(0.22, 0.72, 0.24, 1),
      filter var(--duration-base) var(--ease-out);
  }

  .brand-motto-orbit::before {
    position: absolute;
    inset: 0;
    background: var(--color-brand-secondary);
    -webkit-mask: url('/brand/praxis-motto-orbit.png') center / 100% 100% no-repeat;
    mask: url('/brand/praxis-motto-orbit.png') center / 100% 100% no-repeat;
    content: '';
    opacity: 0.56;
  }

  .brand-motto-orbit :global(svg) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .brand-motto-orbit-path {
    fill: none;
    stroke: var(--color-brand-secondary);
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .brand-motto-text {
    position: relative;
    z-index: 3;
    color: var(--color-fg);
    font-family: 'Praxis Brand Serif';
    font-size: 1rem;
    font-feature-settings:
      'kern' 1,
      'palt' 1;
    font-kerning: normal;
    font-weight: 400;
    font-synthesis: none;
    -webkit-text-stroke: 0.12px currentColor;
    letter-spacing: 0.18em;
    line-height: 1;
    paint-order: stroke fill;
    text-indent: 0.18em;
    text-wrap: nowrap;
    white-space: nowrap;
    transition:
      color var(--duration-base) var(--ease-out),
      text-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .brand-motto-glint {
    position: absolute;
    z-index: 4;
    top: 0.2rem;
    right: 0.4rem;
    display: grid;
    width: 0.4375rem;
    height: 0.4375rem;
    place-items: center;
    color: var(--color-brand-secondary);
    filter: drop-shadow(
      0 0 0.28rem color-mix(in srgb, var(--color-brand-secondary) 74%, transparent)
    );
    opacity: 0.94;
    pointer-events: none;
  }

  @supports (offset-path: path('M 0 0 L 1 1')) {
    .brand-motto-glint {
      top: 0;
      right: auto;
      left: 0;
      offset-distance: 82%;
      offset-path: path('M 7 28 C 31 34 73 32 98 18 C 105 14 106 9 99 6');
      offset-rotate: 0deg;
    }
  }

  .brand-motto-glint :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-item--knowledge {
    gap: 0.0625rem;
    font-size: 0.8125rem;
    line-height: 1.85;
    white-space: nowrap;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.85;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Invisible hit-area extension: comfortable tap targets without moving a pixel. */
  .nav-link::before {
    position: absolute;
    inset: -0.8rem -0.45rem;
    content: '';
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    background: var(--color-brand);
    content: '';
    opacity: 0;
    transform: scaleX(0.3);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .nav-link--active {
    color: var(--color-fg);
  }

  .knowledge-menu-overview-link::before {
    inset-inline-end: 0;
  }

  .knowledge-menu {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    position: relative;
    --knowledge-menu-radius: 0.75rem;
    --knowledge-menu-border: var(--color-line-emphasis);
    --knowledge-menu-divider: color-mix(in srgb, var(--color-line) 56%, transparent);
    --knowledge-menu-surface: color-mix(
      in srgb,
      var(--color-bg-raised) 88%,
      var(--color-brand-tint)
    );
    --knowledge-menu-hover: color-mix(in srgb, var(--color-bg-raised) 40%, var(--color-brand-tint));
    --knowledge-menu-hover-edge: color-mix(in srgb, var(--color-brand) 72%, transparent);
    --knowledge-menu-shadow: var(--shadow-raised);
  }

  .knowledge-menu-trigger {
    position: relative;
    display: inline-flex;
    min-inline-size: 1.125rem;
    min-block-size: 1.5rem;
    align-items: center;
    justify-content: center;
    color: var(--color-fg-muted);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Keep the arrow independently operable without letting its target cover the overview link. */
  .knowledge-menu-trigger::before {
    position: absolute;
    inset-block: -0.8rem;
    inset-inline-start: 0;
    inset-inline-end: -0.375rem;
    content: '';
  }

  .knowledge-menu-trigger::-webkit-details-marker {
    display: none;
  }

  .knowledge-menu-trigger::marker {
    content: '';
  }

  .knowledge-menu-trigger-icon {
    display: block;
    width: 0.625rem;
    height: 0.375rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transform: translateY(0.075em);
  }

  .knowledge-menu-trigger:focus-visible {
    /* Keep an icon-only control visibly focused across desktop and touch browsers. */
    color: var(--color-fg);
    box-shadow: none;
    outline: 0;
  }

  .knowledge-menu-trigger::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 2px;
    background: var(--color-focus-ring);
    content: '';
    opacity: 0;
    transform: scaleX(0.3);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .knowledge-menu-trigger:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .knowledge-menu[open] > .knowledge-menu-trigger {
    color: var(--color-fg);
  }

  .knowledge-menu-flyout {
    position: absolute;
    z-index: 30;
    inset-block-start: 100%;
    inset-inline-end: 0;
    width: min(20rem, calc(100vw - 3rem));
    padding-block-start: 0.55rem;
  }

  .knowledge-menu-panel {
    max-height: calc(100svh - var(--header-height) - 2rem);
    overflow: hidden auto;
    overscroll-behavior: contain;
    border: 1px solid var(--knowledge-menu-border);
    border-radius: var(--knowledge-menu-radius);
    background: var(--knowledge-menu-surface);
    box-shadow: var(--knowledge-menu-shadow);
  }

  .knowledge-menu-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knowledge-menu-link {
    display: grid;
    gap: 0.22rem;
    padding: 0.7rem 0.85rem;
    border-top: 1px solid var(--knowledge-menu-divider);
    color: var(--color-fg);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .knowledge-menu-list > li:first-child .knowledge-menu-link {
    border-top: 0;
  }

  .knowledge-menu-link[aria-current='page'] {
    color: var(--color-fg);
  }

  .knowledge-menu-link:focus-visible {
    z-index: 1;
    background: var(--knowledge-menu-hover);
    box-shadow: inset 2px 0 0 var(--knowledge-menu-hover-edge);
    outline-offset: -3px;
  }

  .knowledge-menu-label {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .knowledge-menu-description {
    color: var(--color-fg-muted);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    line-height: 1.45;
  }

  .nav-link:focus-visible::after,
  .nav-link--active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark,
    .brand:hover .brand-name {
      opacity: 0.78;
    }

    .brand:hover .brand-motto-orbit {
      opacity: 0.58;
      filter: drop-shadow(
        0 0 0.22rem color-mix(in srgb, var(--color-brand-secondary) 30%, transparent)
      );
      transform: translateX(0.06rem) scaleX(1.006);
    }

    .brand:hover .brand-motto-text {
      color: color-mix(in srgb, var(--color-fg) 88%, var(--color-brand-secondary));
      text-shadow: 0.42em 0 0.85em color-mix(in srgb, var(--color-brand-secondary) 18%, transparent);
      transform: translateY(-0.02rem);
    }

    .brand:hover .brand-motto-glint {
      animation-duration: 2.8s;
    }

    .nav-link:hover {
      color: var(--color-fg);
    }

    .nav-link:hover::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .knowledge-menu-trigger:hover {
      color: var(--color-fg);
    }

    .knowledge-menu-link:hover {
      background: var(--knowledge-menu-hover);
      box-shadow: inset 2px 0 0 var(--knowledge-menu-hover-edge);
      color: var(--color-fg);
    }

    .knowledge-menu-link:hover .knowledge-menu-label {
      font-weight: 600;
    }
  }

  .knowledge-menu-link:focus-visible .knowledge-menu-label {
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand-motto::after {
      animation: brand-atmosphere-drift 9.6s cubic-bezier(0.45, 0.05, 0.24, 1) 1.8s infinite;
    }

    .brand-motto-orbit {
      animation: brand-orbit-breathe 7.2s ease-in-out 1.9s infinite alternate;
    }

    .brand-motto-orbit-path {
      animation: brand-orbit-draw 1.8s cubic-bezier(0.72, 0.05, 0.25, 1) 0.08s both;
    }

    .brand-motto-text {
      animation: brand-motto-emerge 0.9s var(--ease-out) 0.62s both;
    }

    .brand-motto-glint {
      animation: brand-glint-travel 7.2s ease-in-out 1.9s infinite alternate;
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .brand-motto-orbit {
        animation: brand-orbit-scroll-breathe 1s linear both;
        animation-timeline: scroll(root block);
        animation-range: 0% 100%;
      }
    }
  }

  @keyframes brand-orbit-draw {
    from {
      stroke-dashoffset: 1;
    }

    78% {
      stroke-dashoffset: 0.12;
    }

    93%,
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes brand-orbit-breathe {
    from,
    to {
      opacity: 0.4;
      transform: translate3d(0, 0, 0) scaleX(1);
    }

    50% {
      opacity: 0.54;
      transform: translate3d(0.015rem, -0.01rem, 0) scaleX(1.001);
    }
  }

  @keyframes brand-orbit-scroll-breathe {
    0% {
      opacity: 0.4;
      transform: translate3d(0, 0, 0) scaleX(1);
    }

    50% {
      opacity: 0.54;
      transform: translate3d(0.015rem, -0.01rem, 0) scaleX(1.001);
    }

    100% {
      opacity: 0.44;
      transform: translate3d(0, 0, 0) scaleX(1);
    }
  }

  @keyframes brand-atmosphere-drift {
    0% {
      opacity: 0.025;
      background-position:
        0% 78%,
        0 0,
        0.2rem 0.1rem,
        -0.1rem 0.18rem;
      transform: translate3d(-0.08rem, 0.02rem, 0);
    }

    18% {
      opacity: 0.07;
    }

    58% {
      opacity: 0.095;
      background-position:
        58% 48%,
        0.1rem -0.04rem,
        0.08rem 0.18rem,
        0.04rem 0.08rem;
      transform: translate3d(0, -0.015rem, 0);
    }

    88% {
      opacity: 0.065;
    }

    100% {
      opacity: 0.02;
      background-position:
        100% 8%,
        0.2rem -0.08rem,
        -0.04rem 0.26rem,
        0.18rem -0.02rem;
      transform: translate3d(0.08rem, -0.02rem, 0);
    }
  }

  @keyframes brand-motto-emerge {
    from {
      opacity: 0;
      transform: translate3d(0, 0.375rem, 0);
      text-shadow: 0 0 0.58em color-mix(in srgb, var(--color-brand-secondary) 28%, transparent);
    }

    72% {
      opacity: 0.96;
      transform: translate3d(0, 0.03rem, 0);
      text-shadow: 0 0 0.2em color-mix(in srgb, var(--color-brand-secondary) 12%, transparent);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      text-shadow: 0 0 0 color-mix(in srgb, var(--color-brand-secondary) 0%, transparent);
    }
  }

  @keyframes brand-glint-travel {
    0% {
      offset-distance: 2%;
      opacity: 0.38;
      transform: scale(0.72);
    }

    38%,
    68% {
      opacity: 1;
      transform: scale(1);
    }

    100% {
      offset-distance: 98%;
      opacity: 0.6;
      transform: scale(0.82);
    }
  }

  @media (max-width: 43rem) {
    .brand-motto {
      display: none;
    }

    .site-header :global(.page-shell) {
      position: relative;
      align-items: flex-start;
      padding-block: 1rem;
    }

    .knowledge-menu {
      position: static;
    }

    .nav-item--knowledge {
      position: static;
    }

    .knowledge-menu-flyout {
      inset-inline: 0;
      width: auto;
    }

    .knowledge-menu-panel {
      max-height: calc(100svh - 8.5rem);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-bg-surface);
      backdrop-filter: none;
    }
  }

  @media (forced-colors: active) {
    .brand-motto-orbit,
    .brand-motto-glint {
      display: none;
    }

    .brand-motto-text {
      color: CanvasText;
      text-shadow: none;
    }
  }

  @media (max-width: 23rem) {
    .site-header :global(.page-shell) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem 1rem;
      align-items: center;
    }

    .header-actions {
      display: contents;
    }

    .header-actions nav {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .header-actions nav ul {
      justify-content: flex-start;
    }

    .header-actions > div {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
