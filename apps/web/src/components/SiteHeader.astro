---
import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="page-shell flex min-h-[var(--header-height)] items-center justify-between gap-5">
    <a class="brand" href="/" aria-label={`${siteConfig.name} · ${uiCopy.navigation.home}`}>
      <img
        class="brand-mark"
        src="/brand/favicon-mini-32x32.png"
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-name">{siteConfig.name}</span>
      <span class="brand-motto">{siteConfig.theme}</span>
    </a>

    <div class="header-actions flex items-center justify-end gap-3 sm:gap-5">
      <nav aria-label={uiCopy.accessibility.primaryNavigation}>
        <ul class="nav-list flex flex-wrap items-center justify-end gap-x-3 gap-y-1 sm:gap-x-5">
          {
            siteConfig.navigation.map((item) => (
              <li>
                <a
                  class:list={['nav-link', isActive(item.href) && 'nav-link--active']}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div aria-label={uiCopy.accessibility.themeControl}>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-overlay-header);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .brand-mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .brand-name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .brand-motto {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-line);
    color: var(--color-fg-muted);
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Invisible hit-area extension: comfortable tap targets without moving a pixel. */
  .nav-link::before {
    position: absolute;
    inset: -0.8rem -0.45rem;
    content: '';
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    background: var(--color-brand);
    content: '';
    opacity: 0;
    transform: scaleX(0.3);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .nav-link--active {
    color: var(--color-fg);
  }

  .nav-link:focus-visible::after,
  .nav-link--active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      opacity: 0.72;
    }

    .nav-link:hover {
      color: var(--color-fg);
    }

    .nav-link:hover::after {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (max-width: 43rem) {
    .brand-motto {
      display: none;
    }

    .site-header :global(.page-shell) {
      align-items: flex-start;
      padding-block: 1rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-bg-surface);
      backdrop-filter: none;
    }
  }

  @media (max-width: 23rem) {
    .site-header :global(.page-shell) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem 1rem;
      align-items: center;
    }

    .header-actions {
      display: contents;
    }

    .header-actions nav {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .header-actions nav ul {
      justify-content: flex-start;
    }

    .header-actions > div {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
