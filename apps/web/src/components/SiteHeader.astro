---
import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="page-shell flex min-h-[var(--header-height)] items-center justify-between gap-5">
    <a class="brand" href="/" aria-label={`${siteConfig.name} · ${uiCopy.navigation.home}`}>
      <span class="brand-name">{siteConfig.name}</span>
      <span class="brand-motto">{siteConfig.theme}</span>
    </a>

    <div class="flex items-center justify-end gap-3 sm:gap-5">
      <nav aria-label={uiCopy.accessibility.primaryNavigation}>
        <ul class="nav-list flex flex-wrap items-center justify-end gap-x-3 gap-y-1 sm:gap-x-5">
          {
            siteConfig.navigation.map((item) => (
              <li>
                <a
                  class:list={['nav-link', isActive(item.href) && 'nav-link--active']}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div aria-label={uiCopy.accessibility.themeControl}>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-page) 90%, transparent);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-name {
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .brand-motto {
    color: var(--color-text-faint);
    font-family: var(--font-display);
    font-size: 0.78rem;
  }

  .nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: '';
    opacity: 0;
    transform: scaleX(0.3);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text);
  }

  .nav-link--active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (max-width: 43rem) {
    .brand-motto {
      display: none;
    }

    .site-header :global(.page-shell) {
      align-items: flex-start;
      padding-block: 1rem;
    }
  }
</style>
