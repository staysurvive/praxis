---
import { uiCopy } from '../config/copy';
import { getKnowledgeUrl } from '../lib/content/domain';
import type { KnowledgeSection } from '../lib/content/domain';

interface Props {
  section: KnowledgeSection;
  count: number;
}

const { section, count } = Astro.props;
---

<article class="knowledge-section-card">
  <a href={getKnowledgeUrl(section.slug)}>
    <div>
      <h2>{section.label}</h2>
      <p>{section.description}</p>
    </div>
    <div class="section-card-footer">
      <span>{uiCopy.knowledge.sectionCount(count)}</span>
      <span class="section-action">
        {uiCopy.actions.enterSection}<span aria-hidden="true"> →</span>
      </span>
    </div>
  </a>
</article>

<style>
  .knowledge-section-card {
    min-width: 0;
    border-top: 1px solid var(--color-line);
  }

  a {
    display: grid;
    gap: 2.5rem;
    min-block-size: 17rem;
    padding-block: 2rem;
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: var(--text-title-2);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
    line-height: 1.35;
  }

  p {
    max-width: 30rem;
    margin-top: 0.9rem;
    color: var(--color-fg-muted);
    line-height: 1.85;
  }

  .section-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    margin-top: auto;
    color: var(--color-fg-subtle);
    font-size: var(--text-meta);
  }

  .section-action {
    color: var(--color-brand-strong);
    font-weight: 500;
    letter-spacing: var(--track-meta);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover h2 {
      color: var(--color-brand-strong);
    }
  }
</style>
