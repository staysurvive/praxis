---
import { uiCopy } from '../config/copy';
import { buildPracticeHeatmapViewModel } from '../features/practice/heatmap-model';
import { formatDateKey, getTodayDateKey } from '../lib/date';
import type { PracticeDataset } from '../lib/practice';
import EmptyState from './EmptyState.astro';

interface Props {
  dataset: PracticeDataset;
  mode?: 'overview' | 'journey';
}

const { dataset, mode = 'overview' } = Astro.props satisfies Props;
const isJourney = mode === 'journey';
const todayDateKey = getTodayDateKey();
const { cells, weekLabels, totalEvents, activeDays, contentCount, recentEvents, summary } =
  buildPracticeHeatmapViewModel(dataset, todayDateKey);
---

<section
  class:list={['heatmap-section', isJourney && 'heatmap-section--journey']}
  aria-labelledby="practice-heatmap-title"
>
  {
    isJourney ? (
      <header>
        <p class="eyebrow eyebrow--folio">{uiCopy.journeyPage.rhythmEyebrow}</p>
        <h2 id="practice-heatmap-title">{uiCopy.journeyPage.rhythmTitle}</h2>
        <p>{uiCopy.journeyPage.rhythmDescription}</p>
      </header>
    ) : (
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:items-end">
        <header>
          <p class="eyebrow eyebrow--folio">{uiCopy.heatmap.eyebrow}</p>
          <h2 id="practice-heatmap-title">{uiCopy.heatmap.title}</h2>
          <p>{uiCopy.heatmap.description}</p>
        </header>
        <dl class="stats-grid grid grid-cols-3 gap-3">
          <div>
            <dt>{uiCopy.heatmap.totalEvents}</dt>
            <dd>{totalEvents}</dd>
          </div>
          <div>
            <dt>{uiCopy.heatmap.activeDays}</dt>
            <dd>{activeDays}</dd>
          </div>
          <div>
            <dt>{uiCopy.heatmap.contentCount}</dt>
            <dd>{contentCount}</dd>
          </div>
        </dl>
      </div>
    )
  }

  {
    totalEvents === 0 ? (
      <div class="mt-10">
        <EmptyState description={uiCopy.empty.practice} />
      </div>
    ) : (
      <div class="heatmap-panel mt-10">
        <p class="sr-only">{summary}</p>
        {!isJourney && <p class="heatmap-total">{uiCopy.heatmap.annualTotal(totalEvents)}</p>}
        <div
          class="heatmap-scroll"
          role="region"
          tabindex="0"
          aria-label={uiCopy.heatmap.calendarLabel}
        >
          <div class="heatmap-calendar">
            <div class="heatmap-weekdays" aria-hidden="true">
              {uiCopy.heatmap.weekdayLabels.map((label) => (
                <span>{label}</span>
              ))}
            </div>
            <div class="heatmap-data">
              <div class="heatmap-months" aria-hidden="true">
                {weekLabels.map((label) => (
                  <span>{label}</span>
                ))}
              </div>
              <div class="heatmap-grid" aria-hidden="true">
                {cells.map((cell) => {
                  const date = formatDateKey(cell.date);
                  const label = uiCopy.heatmap.dayLabel(date, cell.count);

                  return (
                    <span
                      class:list={['heatmap-cell', !cell.inRange && 'heatmap-cell--future']}
                      data-level={cell.level}
                      data-tooltip={label}
                      title={label}
                    >
                      <span class="heatmap-tooltip" aria-hidden="true">
                        <strong>{uiCopy.heatmap.eventCount(cell.count)}</strong>
                        <span>{date}</span>
                      </span>
                    </span>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <div class="heatmap-legend" aria-label="实践次数色阶">
          <span>{uiCopy.heatmap.less}</span>
          {[0, 1, 2, 3, 4].map((level) => (
            <i data-level={level} aria-hidden="true" />
          ))}
          <span>{uiCopy.heatmap.more}</span>
        </div>

        {!isJourney && (
          <details class="practice-details mt-8">
            <summary>{uiCopy.heatmap.details}</summary>
            <ol>
              {recentEvents.map((event) => (
                <li>
                  <time datetime={event.date}>{formatDateKey(event.date)}</time>
                  <span>{uiCopy.practiceKinds[event.kind]}</span>
                  {event.note && <p>{event.note}</p>}
                </li>
              ))}
            </ol>
          </details>
        )}
      </div>
    )
  }
</section>

<style>
  .heatmap-section {
    --heatmap-cell-size: clamp(0.72rem, 1.05vw, 0.82rem);
    --heatmap-gap: clamp(0.16rem, 0.25vw, 0.22rem);
    --heatmap-month-height: 1rem;

    display: grid;
    align-content: center;
    grid-template-columns: minmax(0, 1fr);
    min-block-size: var(--panel-min-block-size);
  }

  .heatmap-section--journey {
    min-block-size: 0;
  }

  .heatmap-panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
  }

  header h2,
  header p {
    margin: 0;
  }

  header h2 {
    max-width: 18ch;
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
    line-height: 1.4;
    text-wrap: balance;
  }

  header > p:last-child {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--color-fg-muted);
  }

  .stats-grid {
    margin: 0;
  }

  .stats-grid div {
    padding: 1rem;
    border-left: 1px solid var(--color-line);
  }

  .stats-grid dt {
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--track-meta);
  }

  .stats-grid dd {
    margin: 0.4rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    line-height: 1;
  }

  .heatmap-scroll {
    /* Keep the full upward tooltip inside this scrolling clip, including its hover offset. */
    --heatmap-tooltip-gutter: 3rem;

    display: grid;
    justify-content: center;
    overflow-x: auto;
    overflow-y: hidden;
    padding: calc(1.35rem + var(--heatmap-tooltip-gutter)) 0.15rem 1rem;
    margin-top: calc(-1 * var(--heatmap-tooltip-gutter));
    /* rtl container + ltr grid: opens scrolled to the newest weeks without JS */
    direction: rtl;
    scrollbar-color: var(--color-line-strong) transparent;
  }

  .heatmap-calendar {
    display: grid;
    grid-template-columns: 2.25rem max-content;
    gap: 0.5rem;
    width: max-content;
    direction: ltr;
  }

  .heatmap-weekdays {
    display: grid;
    grid-template-rows: repeat(7, var(--heatmap-cell-size));
    gap: var(--heatmap-gap);
    padding-top: calc(var(--heatmap-month-height) + var(--heatmap-gap));
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
    line-height: var(--heatmap-cell-size);
  }

  .heatmap-weekdays span {
    grid-column: 1;
  }

  .heatmap-weekdays span:nth-child(1) {
    grid-row: 2;
  }

  .heatmap-weekdays span:nth-child(2) {
    grid-row: 4;
  }

  .heatmap-weekdays span:nth-child(3) {
    grid-row: 6;
  }

  .heatmap-data {
    display: grid;
    grid-template-rows: var(--heatmap-month-height) max-content;
    gap: var(--heatmap-gap);
  }

  .heatmap-months {
    display: grid;
    align-items: end;
    grid-template-columns: repeat(53, var(--heatmap-cell-size));
    gap: var(--heatmap-gap);
    color: var(--color-fg-subtle);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: var(--heatmap-month-height);
    opacity: 0.72;
    white-space: nowrap;
  }

  .heatmap-grid {
    display: grid;
    grid-template-rows: repeat(7, var(--heatmap-cell-size));
    grid-auto-flow: column;
    grid-auto-columns: var(--heatmap-cell-size);
    gap: var(--heatmap-gap);
    width: max-content;
  }

  .heatmap-cell {
    position: relative;
    display: block;
    border: 1px solid var(--color-line-subtle);
    border-radius: 1px;
    background: var(--color-data-heat-0);
    cursor: default;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .heatmap-cell[data-level='1'] {
    background: var(--color-data-heat-1);
  }

  .heatmap-cell[data-level='2'] {
    background: var(--color-data-heat-2);
  }

  .heatmap-cell[data-level='3'] {
    background: var(--color-data-heat-3);
  }

  .heatmap-cell[data-level='4'] {
    background: var(--color-data-heat-4);
  }

  .heatmap-cell--future {
    opacity: 0.3;
  }

  .heatmap-cell:hover {
    z-index: 2;
    opacity: 1;
    transform: scale(1.15);
  }

  .heatmap-tooltip {
    position: absolute;
    z-index: 3;
    bottom: calc(100% + 0.3rem);
    left: 50%;
    display: grid;
    gap: 0.0625rem;
    width: max-content;
    max-width: 13rem;
    padding: 0.3125rem 0.4375rem;
    border: 1px solid var(--color-line-emphasis);
    border-radius: 0.375rem;
    background: var(--color-bg-raised);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.25rem);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .heatmap-tooltip strong {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .heatmap-tooltip span {
    color: var(--color-fg-muted);
    font-size: 0.625rem;
    font-weight: 500;
  }

  .heatmap-cell:hover .heatmap-tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .heatmap-total {
    margin: 0;
    color: var(--color-fg-muted);
    font-family: var(--font-serif);
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--track-cjk-display);
    line-height: 1.35;
  }

  .heatmap-legend {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: 0.3rem;
    min-height: 1rem;
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
    line-height: 1;
  }

  .heatmap-legend span:first-child {
    margin-right: 0.1rem;
  }

  .heatmap-legend span:last-child {
    margin-left: 0.1rem;
  }

  .heatmap-legend i {
    display: block;
    width: var(--heatmap-cell-size);
    aspect-ratio: 1;
    border: 1px solid var(--color-line-subtle);
    border-radius: 1px;
    background: var(--color-data-heat-0);
  }

  .heatmap-legend i[data-level='1'] {
    background: var(--color-data-heat-1);
  }

  .heatmap-legend i[data-level='2'] {
    background: var(--color-data-heat-2);
  }

  .heatmap-legend i[data-level='3'] {
    background: var(--color-data-heat-3);
  }

  .heatmap-legend i[data-level='4'] {
    background: var(--color-data-heat-4);
  }

  .practice-details {
    border-top: 1px solid var(--color-line);
    padding-top: 1.2rem;
  }

  .practice-details summary {
    width: fit-content;
    color: var(--color-fg-muted);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--track-meta);
    cursor: pointer;
  }

  .practice-details ol {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .practice-details li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.35fr) minmax(4rem, 0.2fr) minmax(0, 1fr);
    gap: 0.8rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-fg-muted);
    font-size: var(--text-meta);
  }

  .practice-details li time {
    color: var(--color-fg-subtle);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .practice-details li span {
    color: var(--color-fg-subtle);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .practice-details li p {
    margin: 0;
  }

  @media (max-width: 40rem) {
    .heatmap-section {
      --heatmap-cell-size: 0.72rem;
      --heatmap-gap: 0.2rem;
    }

    .heatmap-calendar {
      grid-template-columns: 2rem max-content;
    }

    .heatmap-scroll {
      justify-content: start;
    }

    .heatmap-total {
      font-size: var(--text-meta);
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .practice-details li {
      grid-template-columns: 1fr auto;
    }

    .practice-details li p {
      grid-column: 1 / -1;
    }
  }
</style>
