---
import { uiCopy } from '../config/copy';
import { formatDateKey, getTodayDateKey } from '../lib/date';
import { buildHeatmapCalendar } from '../lib/practice';
import type { PracticeDataset } from '../lib/practice';
import EmptyState from './EmptyState.astro';

interface Props {
  dataset: PracticeDataset;
}

const { dataset } = Astro.props;
const cells = buildHeatmapCalendar(dataset, getTodayDateKey());
const firstDate = cells.at(0)?.date;
const lastDate = cells.at(-1)?.date;
const visibleEvents = dataset.events.filter(
  (event) => (!firstDate || event.date >= firstDate) && (!lastDate || event.date <= lastDate),
);
const visibleActiveDays = new Set(visibleEvents.map((event) => event.date)).size;
const recentEvents = [...visibleEvents].reverse().slice(0, 8);
const summary = uiCopy.heatmap.summary(visibleEvents.length, visibleActiveDays);
---

<section class="heatmap-section" aria-labelledby="practice-heatmap-title">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:items-end">
    <header>
      <p class="eyebrow eyebrow--folio">{uiCopy.heatmap.eyebrow}</p>
      <h2 id="practice-heatmap-title">{uiCopy.heatmap.title}</h2>
      <p>{uiCopy.heatmap.description}</p>
    </header>
    <dl class="stats-grid grid grid-cols-3 gap-3">
      <div>
        <dt>{uiCopy.heatmap.totalEvents}</dt>
        <dd>{dataset.totalEvents}</dd>
      </div>
      <div>
        <dt>{uiCopy.heatmap.activeDays}</dt>
        <dd>{dataset.activeDays}</dd>
      </div>
      <div>
        <dt>{uiCopy.heatmap.contentCount}</dt>
        <dd>{dataset.contentCount}</dd>
      </div>
    </dl>
  </div>

  {
    dataset.events.length === 0 ? (
      <div class="mt-10">
        <EmptyState description={uiCopy.empty.practice} />
      </div>
    ) : (
      <div class="heatmap-panel mt-10">
        <p class="sr-only">{summary}</p>
        <div
          class="heatmap-scroll"
          role="region"
          tabindex="0"
          aria-label={uiCopy.heatmap.calendarLabel}
        >
          <div class="heatmap-grid" aria-hidden="true">
            {cells.map((cell) => (
              <span
                class:list={['heatmap-cell', !cell.inRange && 'heatmap-cell--future']}
                data-level={cell.level}
                title={`${formatDateKey(cell.date)} · ${uiCopy.heatmap.eventCount(cell.count)}`}
              />
            ))}
          </div>
        </div>

        <div class="heatmap-legend mt-4 flex items-center justify-end gap-2">
          <span>{uiCopy.heatmap.less}</span>
          {[0, 1, 2, 3, 4].map((level) => (
            <i data-level={level} aria-hidden="true" />
          ))}
          <span>{uiCopy.heatmap.more}</span>
        </div>

        <details class="practice-details mt-8">
          <summary>{uiCopy.heatmap.details}</summary>
          <ol>
            {recentEvents.map((event) => (
              <li>
                <time datetime={event.date}>{formatDateKey(event.date)}</time>
                <span>{uiCopy.practiceKinds[event.kind]}</span>
                {event.note && <p>{event.note}</p>}
              </li>
            ))}
          </ol>
        </details>
      </div>
    )
  }
</section>

<style>
  .heatmap-panel {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  header h2,
  header p {
    margin: 0;
  }

  header h2 {
    max-width: 18ch;
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
    line-height: 1.4;
    text-wrap: balance;
  }

  header > p:last-child {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
  }

  .stats-grid {
    margin: 0;
  }

  .stats-grid div {
    padding: 1rem;
    border-left: 1px solid var(--color-border);
  }

  .stats-grid dt {
    color: var(--color-text-faint);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--track-meta);
  }

  .stats-grid dd {
    margin: 0.4rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    line-height: 1;
  }

  .heatmap-scroll {
    overflow-x: auto;
    padding: 0.35rem 0.15rem 0.75rem;
    /* rtl container + ltr grid: opens scrolled to the newest weeks without JS */
    direction: rtl;
    scrollbar-color: var(--color-border-strong) transparent;
  }

  .heatmap-grid {
    display: grid;
    direction: ltr;
    grid-template-rows: repeat(7, 0.72rem);
    grid-auto-flow: column;
    grid-auto-columns: 0.72rem;
    gap: 0.24rem;
    width: max-content;
    min-width: 100%;
  }

  .heatmap-cell,
  .heatmap-legend i {
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 1px;
    background: var(--color-heat-0);
  }

  .heatmap-cell[data-level='1'],
  .heatmap-legend i[data-level='1'] {
    background: var(--color-heat-1);
  }

  .heatmap-cell[data-level='2'],
  .heatmap-legend i[data-level='2'] {
    background: var(--color-heat-2);
  }

  .heatmap-cell[data-level='3'],
  .heatmap-legend i[data-level='3'] {
    background: var(--color-heat-3);
  }

  .heatmap-cell[data-level='4'],
  .heatmap-legend i[data-level='4'] {
    background: var(--color-heat-4);
  }

  .heatmap-cell--future {
    opacity: 0.3;
  }

  .heatmap-legend {
    color: var(--color-text-faint);
    font-size: var(--text-kicker);
  }

  .heatmap-legend i {
    width: 0.72rem;
    height: 0.72rem;
  }

  .practice-details {
    border-top: 1px solid var(--color-border);
    padding-top: 1.2rem;
  }

  .practice-details summary {
    width: fit-content;
    color: var(--color-text-muted);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: var(--track-meta);
    cursor: pointer;
  }

  .practice-details ol {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .practice-details li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.35fr) minmax(4rem, 0.2fr) minmax(0, 1fr);
    gap: 0.8rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
  }

  .practice-details li time {
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .practice-details li span {
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .practice-details li p {
    margin: 0;
  }

  @media (max-width: 40rem) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .practice-details li {
      grid-template-columns: 1fr auto;
    }

    .practice-details li p {
      grid-column: 1 / -1;
    }
  }
</style>
