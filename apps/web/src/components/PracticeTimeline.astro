---
import { uiCopy } from '../config/copy';
import type { NormalizedPracticeEvent } from '../lib/practice';
import { formatDateKey } from '../lib/date';

interface Props {
  events: NormalizedPracticeEvent[];
}

const { events } = Astro.props;
const orderedEvents = [...events].reverse();
---

<section class="practice-timeline rule-scotch" aria-labelledby="practice-timeline-title">
  <header class="timeline-heading">
    <p class="eyebrow">{uiCopy.timeline.eyebrow}</p>
    <h2 id="practice-timeline-title">{uiCopy.timeline.title}</h2>
    <p>{uiCopy.timeline.description}</p>
  </header>

  <ol>
    {
      orderedEvents.map((event) => (
        <li>
          <span class="timeline-dot" aria-hidden="true" />
          <div class="timeline-meta">
            <span>{uiCopy.practiceKinds[event.kind]}</span>
            <time datetime={event.date}>{formatDateKey(event.date)}</time>
          </div>
          {event.note && <p>{event.note}</p>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .practice-timeline {
    display: grid;
    align-content: center;
    min-block-size: var(--panel-min-block-size);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .timeline-heading {
    max-width: 38rem;
  }

  .timeline-heading h2,
  .timeline-heading p {
    margin: 0;
  }

  .timeline-heading h2 {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: var(--text-title-1);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
  }

  .timeline-heading > p:last-child {
    margin-top: 1rem;
    color: var(--color-fg-muted);
  }

  ol {
    max-width: 48rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 0 0 2.4rem 2.25rem;
    border-left: 1px solid var(--color-line);
  }

  li:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    top: 0.35rem;
    left: -0.28rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow: 0 0 0 3px var(--color-bg);
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    align-items: baseline;
    color: var(--color-fg-subtle);
    font-size: var(--text-kicker);
  }

  .timeline-meta span {
    color: var(--color-fg-subtle);
    font-weight: 500;
    letter-spacing: var(--track-meta);
  }

  .timeline-meta time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  li p {
    margin: 0.55rem 0 0;
    color: var(--color-fg-muted);
    line-height: 1.85;
  }
</style>
