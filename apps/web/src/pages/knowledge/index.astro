---
import ContentCard from '../../components/ContentCard.astro';
import KnowledgeSectionCard from '../../components/KnowledgeSectionCard.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { uiCopy } from '../../config/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listKnowledgeSectionEntries, listRecentKnowledge } from '../../lib/content';
import { knowledgeSections } from '../../lib/content/domain';

const sectionCounts = new Map(
  await Promise.all(
    knowledgeSections.map(
      async (section) =>
        [section.key, (await listKnowledgeSectionEntries(section.key)).length] as const,
    ),
  ),
);
const recentEntries = await listRecentKnowledge();
---

<BaseLayout title={uiCopy.knowledge.title} description={uiCopy.knowledge.description}>
  <PageHero
    eyebrow={uiCopy.knowledge.eyebrow}
    title={uiCopy.knowledge.title}
    description={uiCopy.knowledge.description}
  />

  <section class="knowledge-sections" aria-label={uiCopy.knowledge.title}>
    <div class="page-shell section-grid">
      {
        knowledgeSections.map((section) => (
          <KnowledgeSectionCard section={section} count={sectionCounts.get(section.key) ?? 0} />
        ))
      }
    </div>
  </section>

  <section class="recent-knowledge rule-scotch" aria-labelledby="recent-knowledge-title">
    <div class="page-shell">
      <SectionHeading
        eyebrow={uiCopy.knowledge.recentEyebrow}
        title={uiCopy.knowledge.recentTitle}
        description={uiCopy.knowledge.recentDescription}
        titleId="recent-knowledge-title"
      />
      <div class="recent-list">
        {recentEntries.map((entry) => <ContentCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .knowledge-sections,
  .recent-knowledge {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-line);
  }

  .recent-list {
    margin-top: clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--color-line);
  }

  @media (max-width: 42rem) {
    .section-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
