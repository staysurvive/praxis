---
import KnowledgeWorkspaceOverview from '../../components/knowledge/KnowledgeWorkspaceOverview.astro';
import { getKnowledgeIndexModel } from '../../features/knowledge/model';
import KnowledgeDocsLayout from '../../layouts/KnowledgeDocsLayout.astro';

const model = await getKnowledgeIndexModel();
---

<KnowledgeDocsLayout
  title={model.layout.title}
  description={model.layout.description}
  canonicalPath={model.layout.canonicalPath}
  navigationPath={model.layout.navigationPath}
  seoType={model.layout.seoType}
  publishedAt={model.layout.publishedAt}
  updatedAt={model.layout.updatedAt}
  tags={model.layout.tags}
  overviewHref={model.layout.overviewHref}
  sidebarSections={model.layout.sidebarSections}
  recentEntries={model.layout.recentEntries}
  tocItems={model.tocItems}
  overviewIsCurrent={model.layout.overviewIsCurrent}
>
  <KnowledgeWorkspaceOverview
    sections={model.view.sections}
    recentEntries={model.view.recentEntries}
  />
</KnowledgeDocsLayout>
