---
import KnowledgeWorkspaceOverview from '../../components/knowledge/KnowledgeWorkspaceOverview.astro';
import type {
  KnowledgeSidebarEntry,
  KnowledgeSidebarSection,
  KnowledgeTocItem,
} from '../../components/knowledge/types';
import { uiCopy } from '../../config/copy';
import KnowledgeDocsLayout from '../../layouts/KnowledgeDocsLayout.astro';
import { listKnowledgeSectionEntries, listRecentKnowledge } from '../../lib/content';
import {
  getKnowledgeNavigationUrl,
  getKnowledgeUrl,
  knowledgeSections,
} from '../../lib/content/domain';

const sectionCounts = new Map(
  await Promise.all(
    knowledgeSections.map(
      async (section) =>
        [section.key, (await listKnowledgeSectionEntries(section.key)).length] as const,
    ),
  ),
);
const recentEntries = await listRecentKnowledge();
const sidebarSections = knowledgeSections.map((section): KnowledgeSidebarSection => ({
  key: section.key,
  href: getKnowledgeNavigationUrl({ section: section.key }),
  number: section.number,
  label: section.label,
  description: section.description,
  topics: section.topics,
  count: sectionCounts.get(section.key) ?? 0,
  isCurrent: false,
}));
const sidebarEntries = recentEntries.map((entry): KnowledgeSidebarEntry => ({
  key: entry.contentId,
  href: getKnowledgeNavigationUrl({
    section: entry.knowledgeSections?.[0],
    item: entry.slug,
  }),
  title: entry.title,
  summary: entry.summary,
  tags: entry.tags,
  typeLabel: entry.typeLabel,
  updatedAt: entry.updatedAt,
  isCurrent: false,
}));
const tocItems = [
  { id: 'workspace-start', text: uiCopy.knowledge.startReadingTitle, depth: 2 },
  { id: 'workspace-chapters', text: uiCopy.knowledge.browseChaptersTitle, depth: 2 },
  { id: 'workspace-recent', text: uiCopy.knowledge.recentTitle, depth: 2 },
] satisfies readonly KnowledgeTocItem[];
---

<KnowledgeDocsLayout
  title={uiCopy.knowledge.title}
  description={uiCopy.knowledge.description}
  canonicalPath={getKnowledgeUrl()}
  navigationPath={getKnowledgeNavigationUrl()}
  sidebarSections={sidebarSections}
  recentEntries={sidebarEntries}
  tocItems={tocItems}
  overviewIsCurrent
>
  <KnowledgeWorkspaceOverview sections={sidebarSections} recentEntries={sidebarEntries} />
</KnowledgeDocsLayout>
