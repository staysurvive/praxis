---
import KnowledgeArticleView from '../../components/knowledge/KnowledgeArticleView.astro';
import KnowledgeSectionView from '../../components/knowledge/KnowledgeSectionView.astro';
import {
  getKnowledgeArticleModel,
  projectKnowledgeArticleToc,
} from '../../features/knowledge/model';
import KnowledgeDocsLayout from '../../layouts/KnowledgeDocsLayout.astro';
import {
  getContentEntries,
  renderContentEntry,
  selectRecentKnowledge,
  toContentSummary,
} from '../../lib/content';
import {
  assertKnowledgeSlugAvailability,
  isPublicStatus,
  knowledgeSections,
} from '../../lib/content/domain';
import type { KnowledgeSectionKey } from '../../lib/content/domain';

interface Props {
  kind: 'section' | 'content';
  sectionKey?: KnowledgeSectionKey;
  contentId?: string;
}

export async function getStaticPaths() {
  const authoredEntries = await getContentEntries({ includeDrafts: true });
  assertKnowledgeSlugAvailability(authoredEntries.map((entry) => entry.data));

  const publicKnowledgeEntries = selectRecentKnowledge(
    authoredEntries.filter((entry) => isPublicStatus(entry.data.status)).map(toContentSummary),
  );

  return [
    ...knowledgeSections.map((section) => ({
      params: { key: section.slug },
      props: { kind: 'section' as const, sectionKey: section.key },
    })),
    ...publicKnowledgeEntries.map((entry) => ({
      params: { key: entry.slug },
      props: { kind: 'content' as const, contentId: entry.contentId },
    })),
  ];
}

const { kind, sectionKey, contentId } = Astro.props;
const model = await getKnowledgeArticleModel({ kind, sectionKey, contentId });
const renderedEntry = model.kind === 'content' ? await renderContentEntry(model.entry) : undefined;
const Content = renderedEntry?.Content;
const tocItems =
  model.kind === 'section'
    ? model.tocItems
    : projectKnowledgeArticleToc(renderedEntry?.headings ?? []);
---

<KnowledgeDocsLayout
  title={model.layout.title}
  description={model.layout.description}
  canonicalPath={model.layout.canonicalPath}
  navigationPath={model.layout.navigationPath}
  seoType={model.layout.seoType}
  publishedAt={model.layout.publishedAt}
  updatedAt={model.layout.updatedAt}
  tags={model.layout.tags}
  overviewHref={model.layout.overviewHref}
  sidebarSections={model.layout.sidebarSections}
  recentEntries={model.layout.recentEntries}
  tocItems={tocItems}
  overviewIsCurrent={model.layout.overviewIsCurrent}
>
  {
    model.kind === 'section' ? (
      <KnowledgeSectionView
        section={model.view.section}
        entries={model.view.entries}
        previousSection={model.view.previousSection}
        nextSection={model.view.nextSection}
        overviewHref={model.view.overviewHref}
      />
    ) : Content ? (
      <KnowledgeArticleView
        summary={model.view.summary}
        practiceEvents={model.view.practiceEvents}
        backHref={model.view.backHref}
        backLabel={model.view.backLabel}
      >
        <Content />
      </KnowledgeArticleView>
    ) : null
  }
</KnowledgeDocsLayout>
