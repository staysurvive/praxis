---
import KnowledgeArticleView from '../../components/knowledge/KnowledgeArticleView.astro';
import KnowledgeSectionView from '../../components/knowledge/KnowledgeSectionView.astro';
import type {
  KnowledgeSidebarEntry,
  KnowledgeSidebarSection,
  KnowledgeTocItem,
} from '../../components/knowledge/types';
import { uiCopy } from '../../config/copy';
import KnowledgeDocsLayout from '../../layouts/KnowledgeDocsLayout.astro';
import {
  getContentEntries,
  renderContentEntry,
  selectKnowledgeSectionEntries,
  selectRecentKnowledge,
  toContentSummary,
} from '../../lib/content';
import {
  assertKnowledgeSlugAvailability,
  getKnowledgeNavigationUrl,
  getKnowledgeSectionByKey,
  getKnowledgeUrl,
  isPublicStatus,
  knowledgeSections,
} from '../../lib/content/domain';
import type { KnowledgeSectionKey } from '../../lib/content/domain';
import { normalizePracticeEvents, toPracticeSourceEntry } from '../../lib/practice';

interface Props {
  kind: 'section' | 'content';
  sectionKey?: KnowledgeSectionKey;
  contentId?: string;
}

const sectionTocItems = [
  { id: 'section-positioning', text: uiCopy.knowledge.positioningTitle, depth: 2 },
  { id: 'section-topics', text: uiCopy.knowledge.topicsTitle, depth: 2 },
  { id: 'section-entries', text: uiCopy.knowledge.entriesTitle, depth: 2 },
  { id: 'section-navigation', text: uiCopy.knowledge.continueTitle, depth: 2 },
] satisfies readonly KnowledgeTocItem[];

export async function getStaticPaths() {
  const authoredEntries = await getContentEntries({ includeDrafts: true });
  assertKnowledgeSlugAvailability(authoredEntries.map((entry) => entry.data));

  const publicKnowledgeEntries = selectRecentKnowledge(
    authoredEntries.filter((entry) => isPublicStatus(entry.data.status)).map(toContentSummary),
  );

  return [
    ...knowledgeSections.map((section) => ({
      params: { key: section.slug },
      props: { kind: 'section' as const, sectionKey: section.key },
    })),
    ...publicKnowledgeEntries.map((entry) => ({
      params: { key: entry.slug },
      props: { kind: 'content' as const, contentId: entry.contentId },
    })),
  ];
}

const { kind, sectionKey, contentId } = Astro.props;
const section = sectionKey ? getKnowledgeSectionByKey(sectionKey) : undefined;

const publicEntries = await getContentEntries();
const recentEntries = selectRecentKnowledge(publicEntries.map(toContentSummary));
const recentEntryIds = new Set(recentEntries.map((candidate) => candidate.contentId));
const entry = contentId
  ? publicEntries.find(
      (candidate) =>
        candidate.data.contentId === contentId && recentEntryIds.has(candidate.data.contentId),
    )
  : undefined;

if (kind === 'content' && !entry) {
  throw new Error(`无法为知识路由找到公开内容：${contentId ?? 'missing-content-id'}`);
}
if (kind === 'section' && !section) {
  throw new Error(`无法为知识入口找到注册表定义：${sectionKey ?? 'missing-section-key'}`);
}

const summary = entry ? toContentSummary(entry) : undefined;
const articleSectionKey = summary?.knowledgeSections?.[0];
const articleSection = articleSectionKey ? getKnowledgeSectionByKey(articleSectionKey) : undefined;
const activeSectionKey = section?.key ?? articleSection?.key;
const renderedEntry = entry ? await renderContentEntry(entry) : undefined;
const Content = renderedEntry?.Content;
const practiceEvents = entry ? normalizePracticeEvents([toPracticeSourceEntry(entry.data)]) : [];
const articleTocItems =
  renderedEntry?.headings.flatMap((heading): KnowledgeTocItem[] => {
    if (heading.depth !== 2 && heading.depth !== 3) {
      return [];
    }

    return [{ id: heading.slug, text: heading.text, depth: heading.depth }];
  }) ?? [];

const sectionEntries = section ? selectKnowledgeSectionEntries(recentEntries, section.key) : [];
const sectionIndex = section
  ? knowledgeSections.findIndex((candidate) => candidate.key === section.key)
  : -1;
const previousSection = sectionIndex > 0 ? knowledgeSections[sectionIndex - 1] : undefined;
const nextSection =
  sectionIndex >= 0 && sectionIndex < knowledgeSections.length - 1
    ? knowledgeSections[sectionIndex + 1]
    : undefined;

const sidebarSections = knowledgeSections.map((candidate): KnowledgeSidebarSection => ({
  key: candidate.key,
  href: getKnowledgeNavigationUrl({ section: candidate.key }),
  number: candidate.number,
  label: candidate.label,
  description: candidate.description,
  topics: candidate.topics,
  count: selectKnowledgeSectionEntries(recentEntries, candidate.key).length,
  isCurrent: activeSectionKey === candidate.key,
}));
const sidebarEntries = recentEntries.map((candidate): KnowledgeSidebarEntry => ({
  key: candidate.contentId,
  href: getKnowledgeNavigationUrl({
    section: candidate.knowledgeSections?.[0],
    item: candidate.slug,
  }),
  title: candidate.title,
  summary: candidate.summary,
  tags: candidate.tags,
  typeLabel: candidate.typeLabel,
  updatedAt: candidate.updatedAt,
  isCurrent: candidate.contentId === contentId,
}));

const pageMetadata = section
  ? {
      title: section.label,
      description: section.description,
      canonicalPath: getKnowledgeUrl(section.slug),
      seoType: 'website' as const,
      publishedAt: undefined,
      updatedAt: undefined,
      tags: [] as const,
      tocItems: sectionTocItems,
    }
  : summary
    ? {
        title: summary.title,
        description: summary.summary,
        canonicalPath: summary.url,
        seoType: 'article' as const,
        publishedAt: summary.publishedAt,
        updatedAt: summary.updatedAt,
        tags: summary.tags,
        tocItems: articleTocItems,
      }
    : undefined;

if (!pageMetadata) {
  throw new Error('知识文档页面缺少可渲染的数据。');
}

const navigationPath = section
  ? getKnowledgeNavigationUrl({ section: section.key })
  : summary
    ? getKnowledgeNavigationUrl({ section: articleSectionKey, item: summary.slug })
    : getKnowledgeNavigationUrl();
---

<KnowledgeDocsLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
  canonicalPath={pageMetadata.canonicalPath}
  navigationPath={navigationPath}
  seoType={pageMetadata.seoType}
  publishedAt={pageMetadata.publishedAt}
  updatedAt={pageMetadata.updatedAt}
  tags={pageMetadata.tags}
  sidebarSections={sidebarSections}
  recentEntries={sidebarEntries}
  tocItems={pageMetadata.tocItems}
>
  {
    section ? (
      <KnowledgeSectionView
        section={section}
        entries={sectionEntries}
        previousSection={previousSection}
        nextSection={nextSection}
      />
    ) : summary && Content ? (
      <KnowledgeArticleView
        summary={summary}
        practiceEvents={practiceEvents}
        section={articleSection}
      >
        <Content />
      </KnowledgeArticleView>
    ) : null
  }
</KnowledgeDocsLayout>
