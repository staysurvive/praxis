---
import { uiCopy } from '../../config/copy';
import ContentLayout from '../../layouts/ContentLayout.astro';
import {
  getContentEntries,
  getEntryByContentId,
  renderContentEntry,
  toContentSummary,
} from '../../lib/content';
import { getContentPath, isPublicStatus, legacyProjectDetail } from '../../lib/content/domain';
import { normalizePracticeEvents, toPracticeSourceEntry } from '../../lib/practice';

interface Props {
  contentId: string;
}

export async function getStaticPaths() {
  const projects = await getContentEntries({ type: 'project' });
  const legacyProject = projects.find(
    (entry) => entry.data.contentId === legacyProjectDetail.contentId,
  );

  if (!legacyProject) {
    throw new Error(`无法找到兼容项目详情：${legacyProjectDetail.contentId}`);
  }

  return [
    {
      params: {
        type: getContentPath('project'),
        slug: legacyProjectDetail.slug,
      },
      props: { contentId: legacyProject.data.contentId },
    },
  ];
}

const { contentId } = Astro.props;
const entry = await getEntryByContentId(contentId);

if (!entry || entry.data.type !== 'project' || !isPublicStatus(entry.data.status)) {
  throw new Error(`无法为公开项目详情找到内容：${contentId}`);
}

const summary = toContentSummary(entry);
const { Content } = await renderContentEntry(entry);
const practiceEvents = normalizePracticeEvents([toPracticeSourceEntry(entry.data)]);
---

<ContentLayout
  summary={summary}
  practiceEvents={practiceEvents}
  backHref="/projects"
  backLabel={uiCopy.contentTypes.project}
>
  <Content />
</ContentLayout>
