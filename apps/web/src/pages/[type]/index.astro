---
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { uiCopy } from '../../config/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listEntries } from '../../lib/content';
import { contentTypes, getContentPath } from '../../lib/content/domain';
import type { ContentType } from '../../lib/content/domain';

interface Props {
  type: ContentType;
}

export function getStaticPaths() {
  return contentTypes.map((type) => ({
    params: { type: getContentPath(type) },
    props: { type },
  }));
}

const { type } = Astro.props;
const entries = await listEntries({ type });
const title = uiCopy.contentTypes[type];
const description = uiCopy.listing.descriptions[type];
---

<BaseLayout title={title} description={description}>
  <section class="listing-hero">
    <div
      class="page-shell grid gap-10 pt-20 pb-16 md:pt-28 md:pb-24 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.45fr)] lg:items-end"
    >
      <div>
        <p class="eyebrow mb-5">{uiCopy.listing.eyebrow}</p>
        <h1>{title}</h1>
      </div>
      <div>
        <p class="description">{description}</p>
        <p class="count mt-5">{uiCopy.listing.count(entries.length)}</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      {entries.length > 0 ? entries.map((entry) => <ContentCard entry={entry} />) : <EmptyState />}
    </div>
  </section>
</BaseLayout>

<style>
  .listing-hero {
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 11vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .description,
  .count {
    margin-bottom: 0;
  }

  .description {
    margin-top: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .count {
    color: var(--color-text-faint);
    font-size: 0.78rem;
  }
</style>
