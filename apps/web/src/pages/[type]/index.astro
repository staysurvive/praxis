---
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { uiCopy } from '../../config/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listEntries } from '../../lib/content';
import { contentTypes, getContentPath } from '../../lib/content/domain';
import type { ContentType } from '../../lib/content/domain';

interface Props {
  type: ContentType;
}

export function getStaticPaths() {
  return contentTypes.map((type) => ({
    params: { type: getContentPath(type) },
    props: { type },
  }));
}

const { type } = Astro.props;
const entries = await listEntries({ type });
const title = uiCopy.contentTypes[type];
const description = uiCopy.listing.descriptions[type];
const countLabel = uiCopy.listing.countUnit;
---

<BaseLayout title={title} description={description}>
  <section class="listing-hero rule-scotch--bottom">
    <div
      class="page-shell grid gap-10 pt-20 pb-16 md:pt-28 md:pb-24 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.42fr)] lg:items-end"
    >
      <div>
        <p class="eyebrow mb-5">{uiCopy.listing.eyebrow}</p>
        <h1 class="display-title display-title--wide">{title}</h1>
      </div>
      <div>
        <p class="description">{description}</p>
        <p class="count mt-5">
          <span class="count-numeral">{entries.length}</span>
          {countLabel}
        </p>
      </div>
    </div>
  </section>

  <section class="listing-body">
    <div class="page-shell">
      {
        entries.length > 0 ? (
          <div class="listing-list">
            {entries.map((entry) => (
              <ContentCard entry={entry} />
            ))}
          </div>
        ) : (
          <EmptyState />
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .description,
  .count {
    margin-bottom: 0;
  }

  .description {
    margin-top: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .count {
    color: var(--color-text-faint);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .count-numeral {
    margin-right: 0.35rem;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: 0;
    line-height: 1;
  }

  .listing-body {
    display: grid;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4.5rem, 9vw, 8rem);
  }

  .listing-list {
    border-bottom: var(--rule-hair);
  }

  .listing-list :global(.content-card:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 64rem) {
    .listing-hero,
    .listing-body {
      min-block-size: var(--section-min-block-size);
    }

    .listing-hero {
      display: grid;
      align-items: center;
    }

    .listing-body {
      align-items: center;
    }
  }
</style>
