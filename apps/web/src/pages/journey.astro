---
import EmptyState from '../components/EmptyState.astro';
import EditorialHero from '../components/EditorialHero.astro';
import { uiCopy } from '../config/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  defaultKnowledgeSection,
  getKnowledgeContextUrl,
  getKnowledgeUrl,
} from '../lib/content/domain';
---

<BaseLayout title={uiCopy.journeyPage.title} description={uiCopy.journeyPage.description}>
  <EditorialHero
    eyebrow={uiCopy.journeyPage.eyebrow}
    title={uiCopy.journeyPage.title}
    description={uiCopy.journeyPage.description}
    variant="journey"
  />
  <section class="journey-empty">
    <div class="page-shell">
      <EmptyState
        title={uiCopy.journeyPage.emptyTitle}
        description={uiCopy.journeyPage.emptyDescription}
        actions={[
          {
            label: uiCopy.actions.browseKnowledge,
            href: getKnowledgeContextUrl(
              getKnowledgeUrl(defaultKnowledgeSection.slug),
              defaultKnowledgeSection.key,
            ),
          },
          { label: uiCopy.actions.viewProjects, href: '/projects' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .journey-empty {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
</style>
