---
import ContentCard from '../components/ContentCard.astro';
import PracticeHeatmap from '../components/PracticeHeatmap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { homeContent } from '../config/home';
import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestEntries, listEntries } from '../lib/content';
import { practiceDataset } from '../lib/practice-data';

const latestEntries = await getLatestEntries(3);
const [currentProject] = await listEntries({ type: 'project' });
const year = new Date().getFullYear();
---

<BaseLayout title={siteConfig.title}>
  <section class="hero-section">
    <div
      class="page-shell my-auto grid gap-12 pt-16 pb-12 md:pt-20 md:pb-24 lg:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)] lg:items-end"
    >
      <div>
        <p class="eyebrow mb-7">{homeContent.hero.eyebrow}</p>
        <h1 class="display-title">{homeContent.hero.title}</h1>
      </div>
      <div class="hero-copy lg:pb-3">
        <p class="hero-lead">{homeContent.hero.lead}</p>
        <p class="body-copy mt-6">{homeContent.hero.description}</p>
        {
          currentProject && (
            <a class="text-link mt-7" href={currentProject.url}>
              {uiCopy.actions.viewProject}
            </a>
          )
        }
      </div>
    </div>
    <div class="page-shell">
      <p class="hero-strip">
        <span class="hero-motto">{siteConfig.motto}</span>
        <span class="hero-year">{year}</span>
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <SectionHeading
        eyebrow={homeContent.philosophy.eyebrow}
        title={homeContent.philosophy.title}
        description={homeContent.philosophy.description}
      />

      <div class="philosophy-grid mt-16 grid gap-0 lg:grid-cols-3">
        {
          homeContent.philosophy.stages.map((stage) => (
            <article>
              <div class="flex items-start justify-between gap-5">
                <span class="philosophy-index">{stage.index}</span>
                <span class="philosophy-subtitle">{stage.subtitle}</span>
              </div>
              <span class="philosophy-numeral" data-numeral={stage.index} aria-hidden="true" />
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section">
    <div
      class="page-shell grid gap-10 lg:grid-cols-[minmax(0,0.65fr)_minmax(0,1.35fr)] lg:items-start"
    >
      <div>
        <p class="eyebrow eyebrow--folio mb-5">{homeContent.now.eyebrow}</p>
        <h2 class="now-title">{homeContent.now.title}</h2>
      </div>
      <div class="now-column">
        <p>{homeContent.now.description}</p>
        {currentProject && <ContentCard entry={currentProject} featured />}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <PracticeHeatmap dataset={practiceDataset} />
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <SectionHeading
        eyebrow={homeContent.latest.eyebrow}
        title={homeContent.latest.title}
        description={homeContent.latest.description}
      />
      <div class="latest-list mt-14">
        {latestEntries.map((entry) => <ContentCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height) - 1px);
  }

  .hero-copy {
    max-width: 32rem;
  }

  .hero-lead,
  .hero-copy :global(.body-copy) {
    margin-bottom: 0;
  }

  .hero-lead {
    margin-top: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    letter-spacing: 0.01em;
    line-height: 1.75;
  }

  .hero-motto {
    color: var(--color-text-faint);
    font-family: var(--font-serif);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }

  .hero-year {
    margin-right: -0.22em;
    color: var(--color-text-faint);
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: 0.22em;
  }

  .philosophy-grid {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .philosophy-grid article {
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .philosophy-index,
  .philosophy-subtitle {
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .philosophy-index {
    color: var(--color-accent);
  }

  .philosophy-subtitle {
    margin-right: -0.16em;
    color: var(--color-text-faint);
  }

  .philosophy-numeral {
    display: block;
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--color-accent-soft);
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 8vw, 7rem);
    letter-spacing: var(--track-latin-display);
    line-height: 0.9;
    user-select: none;
  }

  .philosophy-numeral::before {
    content: attr(data-numeral);
  }

  .philosophy-grid h3 {
    margin: auto 0 0;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
  }

  .philosophy-grid p {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.9;
  }

  .now-title {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-title-1);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
    line-height: 1.35;
    text-wrap: balance;
  }

  .now-column {
    padding-left: clamp(1.5rem, 3vw, 3rem);
    border-left: 1px solid var(--color-border);
  }

  .now-column > p {
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .now-column :global(.content-card--featured) {
    margin-top: 2rem;
  }

  .latest-list :global(.content-card:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  @media (max-width: 47.99rem) {
    .hero-section {
      min-height: auto;
    }
  }

  @media (max-width: 63.99rem) {
    .now-column {
      padding-left: 1.25rem;
    }

    .philosophy-index {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .philosophy-grid article {
      min-height: 30rem;
      border-right: 1px solid var(--color-border);
      border-bottom: 0;
    }

    .philosophy-grid article:first-child {
      padding-left: 0;
    }

    .philosophy-grid article:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
