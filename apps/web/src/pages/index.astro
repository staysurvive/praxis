---
import ContentCard from '../components/ContentCard.astro';
import PracticeHeatmap from '../components/PracticeHeatmap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { homeContent } from '../config/home';
import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestEntries, listEntries } from '../lib/content';
import { getKnowledgeNavigationUrl } from '../lib/content/domain';
import { practiceDataset } from '../lib/practice-data';

const latestEntries = await getLatestEntries(3);
const [currentProject] = await listEntries({ type: 'project' });
---

<BaseLayout title={siteConfig.title}>
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <img src="/art/praxis-hero-field-1536.webp" width="1536" height="864" alt="" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="page-shell hero-shell">
      <div class="hero-main">
        <p class="eyebrow hero-eyebrow">{homeContent.hero.eyebrow}</p>
        <h1 id="hero-title" class="display-title hero-title">{homeContent.hero.title}</h1>
        <p class="hero-lead">{homeContent.hero.lead}</p>
        {
          currentProject && (
            <a class="text-link hero-link" href={currentProject.url}>
              {uiCopy.actions.viewProject}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="page-section philosophy-section">
    <div class="philosophy-background" aria-hidden="true">
      <img
        src="/art/praxis-philosophy-field-2048.webp"
        width="2048"
        height="1152"
        alt=""
        loading="lazy"
      />
    </div>
    <div class="philosophy-background-wash" aria-hidden="true"></div>

    <div class="page-shell">
      <SectionHeading
        eyebrow={homeContent.philosophy.eyebrow}
        title={homeContent.philosophy.title}
        description={homeContent.philosophy.description}
      />

      <div class="philosophy-grid mt-16 grid gap-0 lg:grid-cols-3">
        {
          homeContent.philosophy.stages.map((stage) => (
            <article class="philosophy-stage">
              <div class="flex items-start justify-between gap-5">
                <span class="philosophy-index">{stage.index}</span>
                <span class="philosophy-subtitle">{stage.subtitle}</span>
              </div>
              <span class="philosophy-numeral" data-numeral={stage.index} aria-hidden="true" />
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <PracticeHeatmap dataset={practiceDataset} />
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <SectionHeading
        eyebrow={homeContent.latest.eyebrow}
        title={homeContent.latest.title}
        description={homeContent.latest.description}
      />
      <div class="latest-list mt-14">
        {
          latestEntries.map((entry) => (
            <ContentCard
              entry={entry}
              href={
                entry.type === 'project'
                  ? entry.url
                  : getKnowledgeNavigationUrl({
                      section: entry.knowledgeSections?.[0],
                      item: entry.slug,
                    })
              }
              prefetch={entry.type === 'project' ? undefined : 'hover'}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height) - 1px);
    overflow: clip;
    background: var(--color-bg);
  }

  .hero-art,
  .hero-overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    pointer-events: none;
  }

  .hero-art img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-art img {
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    z-index: -1;
    background: linear-gradient(
      90deg,
      var(--color-overlay-hero-strong) 0%,
      var(--color-overlay-hero) 32%,
      transparent 56%
    );
  }

  .hero-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    min-height: inherit;
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .hero-main {
    position: relative;
    z-index: 1;
    max-width: 53rem;
  }

  .hero-eyebrow {
    margin: 0 0 clamp(1.5rem, 4vw, 3rem);
  }

  .hero-title {
    max-width: 5ch;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 31rem;
    margin: clamp(1.75rem, 4vw, 3.5rem) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1.85;
  }

  .hero-link {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .philosophy-grid {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .philosophy-section {
    isolation: isolate;
    overflow: clip;
  }

  .philosophy-section > .page-shell {
    position: relative;
    z-index: 2;
  }

  .philosophy-section::before {
    z-index: 3;
  }

  .philosophy-background,
  .philosophy-background-wash {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .philosophy-background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.9) contrast(1.05);
  }

  .philosophy-background-wash {
    z-index: 1;
    background: var(--color-overlay-philosophy);
  }

  .philosophy-grid article {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .philosophy-grid article::after {
    position: absolute;
    right: auto;
    bottom: 0;
    left: 0;
    width: clamp(2.5rem, 8vw, 5rem);
    height: 2px;
    background: var(--color-brand);
    content: '';
    opacity: 0;
    transform: scaleX(0.45);
    transform-origin: left center;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .philosophy-index,
  .philosophy-subtitle {
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .philosophy-index {
    color: var(--color-brand);
  }

  .philosophy-subtitle {
    margin-right: -0.16em;
    color: var(--color-fg-subtle);
  }

  .philosophy-numeral {
    display: block;
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--color-brand-display);
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 8vw, 7rem);
    letter-spacing: var(--track-latin-display);
    line-height: 0.9;
    transition: color var(--duration-fast) var(--ease-out);
    user-select: none;
  }

  .philosophy-numeral::before {
    content: attr(data-numeral);
  }

  .philosophy-grid h3 {
    margin: auto 0 0;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .philosophy-grid p {
    margin: 1rem 0 0;
    color: var(--color-fg-muted);
    line-height: 1.9;
  }

  .latest-list :global(.content-card:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .philosophy-grid article:hover::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .philosophy-grid article:hover .philosophy-subtitle,
    .philosophy-grid article:hover h3 {
      color: var(--color-brand-strong);
    }

    .philosophy-grid article:hover .philosophy-numeral {
      color: var(--color-brand);
    }
  }

  @media (max-width: 47.99rem) {
    .hero-section {
      min-height: auto;
    }

    .hero-art {
      right: 0;
      bottom: auto;
      left: 0;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .hero-art img {
      object-fit: contain;
    }

    .hero-overlay {
      display: none;
    }

    .hero-shell {
      min-height: 0;
      padding: calc(56.25vw + 2rem) 0 4rem;
    }

    .philosophy-background img {
      object-position: 62% center;
    }

    .philosophy-background-wash {
      background: var(--color-overlay-philosophy-mobile);
    }
  }

  @media (max-width: 63.99rem) {
    .philosophy-index {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .hero-shell {
      padding-block: 3rem;
    }

    .philosophy-grid article {
      min-block-size: var(--panel-min-block-size);
      border-right: 1px solid var(--color-line);
      border-bottom: 0;
    }

    .philosophy-grid article:first-child {
      padding-left: 0;
    }

    .philosophy-grid article:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
