---
import ContentCard from '../components/ContentCard.astro';
import PracticeHeatmap from '../components/PracticeHeatmap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { homeContent } from '../config/home';
import { uiCopy } from '../config/copy';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestEntries, listEntries } from '../lib/content';
import { practiceDataset } from '../lib/practice-data';

const latestEntries = await getLatestEntries(3);
const [currentProject] = await listEntries({ type: 'project' });
---

<BaseLayout title={siteConfig.title}>
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <img src="/art/praxis-hero-field-1536.webp" width="1536" height="864" alt="" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="page-shell hero-shell">
      <div class="hero-main">
        <p class="eyebrow hero-eyebrow">{homeContent.hero.eyebrow}</p>
        <h1 id="hero-title" class="display-title hero-title">{homeContent.hero.title}</h1>
        <p class="hero-lead">{homeContent.hero.lead}</p>
        {
          currentProject && (
            <a class="text-link hero-link" href={currentProject.url}>
              {uiCopy.actions.viewProject}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <SectionHeading
        eyebrow={homeContent.philosophy.eyebrow}
        title={homeContent.philosophy.title}
        description={homeContent.philosophy.description}
      />

      <div class="philosophy-grid mt-16 grid gap-0 lg:grid-cols-3">
        {
          homeContent.philosophy.stages.map((stage) => (
            <article class="philosophy-stage">
              <div class="flex items-start justify-between gap-5">
                <span class="philosophy-index">{stage.index}</span>
                <span class="philosophy-subtitle">{stage.subtitle}</span>
              </div>
              <span class="philosophy-numeral" data-numeral={stage.index} aria-hidden="true" />
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
            </article>
          ))
        }
      </div>

      <div class="philosophy-art" aria-hidden="true">
        <img
          src="/art/praxis-hero-garden-1536.webp"
          width="1536"
          height="864"
          alt=""
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <PracticeHeatmap dataset={practiceDataset} />
    </div>
  </section>

  <section class="page-section">
    <div class="page-shell">
      <SectionHeading
        eyebrow={homeContent.latest.eyebrow}
        title={homeContent.latest.title}
        description={homeContent.latest.description}
      />
      <div class="latest-list mt-14">
        {latestEntries.map((entry) => <ContentCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height) - 1px);
    overflow: clip;
    background: var(--color-page);
  }

  .hero-art,
  .hero-overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    pointer-events: none;
  }

  .hero-art img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-art img {
    object-fit: contain;
    object-position: center;
  }

  .hero-overlay {
    z-index: -1;
    background: linear-gradient(
      90deg,
      var(--color-hero-veil-strong) 0%,
      var(--color-hero-veil) 32%,
      transparent 56%
    );
  }

  .hero-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    min-height: inherit;
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .hero-main {
    position: relative;
    z-index: 1;
    max-width: 53rem;
  }

  .hero-eyebrow {
    margin: 0 0 clamp(1.5rem, 4vw, 3rem);
  }

  .hero-title {
    max-width: 5ch;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 31rem;
    margin: clamp(1.75rem, 4vw, 3.5rem) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1.85;
  }

  .hero-link {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .philosophy-grid {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .philosophy-grid article {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .philosophy-grid article::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: color-mix(in srgb, var(--color-accent-soft) 35%, transparent);
    content: '';
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .philosophy-index,
  .philosophy-subtitle {
    font-size: var(--text-kicker);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .philosophy-index {
    color: var(--color-accent);
  }

  .philosophy-subtitle {
    margin-right: -0.16em;
    color: var(--color-text-faint);
  }

  .philosophy-numeral {
    display: block;
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--color-accent-soft);
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 8vw, 7rem);
    letter-spacing: var(--track-latin-display);
    line-height: 0.9;
    user-select: none;
  }

  .philosophy-numeral::before {
    content: attr(data-numeral);
  }

  .philosophy-grid h3 {
    margin: auto 0 0;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
  }

  .philosophy-grid p {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.9;
  }

  .latest-list :global(.content-card:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  .philosophy-art {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    aspect-ratio: 16 / 7.8;
    overflow: hidden;
  }

  .philosophy-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 54%;
  }

  @media (hover: hover) and (pointer: fine) {
    .philosophy-grid article:hover::after {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 47.99rem) {
    .hero-section {
      min-height: auto;
    }

    .hero-art {
      right: 0;
      bottom: auto;
      left: 0;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .hero-overlay {
      display: none;
    }

    .hero-shell {
      min-height: 0;
      padding: calc(56.25vw + 2rem) 0 4rem;
    }
  }

  @media (max-width: 63.99rem) {
    .philosophy-index {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .hero-shell {
      padding-block: 3rem;
    }

    .philosophy-grid article {
      min-block-size: var(--panel-min-block-size);
      border-right: 1px solid var(--color-border);
      border-bottom: 0;
    }

    .philosophy-grid article:first-child {
      padding-left: 0;
    }

    .philosophy-grid article:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
