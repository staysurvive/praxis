---
import { uiCopy } from '../config/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404"
  description={uiCopy.errors.notFoundDescription}
  canonicalPath="/404"
  noindex
>
  <section
    class="page-shell grid min-h-[72svh] content-center gap-10 py-20 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,1.4fr)] lg:items-center"
  >
    <p class="error-code" aria-hidden="true">404</p>
    <div class="error-copy">
      <p class="eyebrow mb-5">Not found</p>
      <h1>{uiCopy.errors.notFoundTitle}</h1>
      <p>{uiCopy.errors.notFoundDescription}</p>
      <a class="text-link mt-8" href="/">{uiCopy.actions.backHome}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .error-code {
    margin: 0;
    color: var(--color-accent-soft);
    font-family: var(--font-serif);
    font-size: clamp(7rem, 20vw, 15rem);
    letter-spacing: var(--track-latin-display);
    line-height: 0.8;
    user-select: none;
  }

  .error-copy {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400;
    letter-spacing: var(--track-cjk-display);
    line-height: 1.3;
  }

  .error-copy > p:last-of-type {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.9;
  }
</style>
